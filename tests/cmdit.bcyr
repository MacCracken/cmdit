# cmdit benchmarks — characterizes the real per-invocation cost of the parser.
# Build/run:  cyrius build tests/cmdit.bcyr build/cmdit-bench && ./build/cmdit-bench
#
# The entry includes the stdlib it uses explicitly, like smoke (see the note there).
#
# Methodology (see docs/benchmarks.md):
#   parse-loop cost  = parse_argv_mixed.avg - setup_baseline.avg
#   register cost    = setup_baseline.avg   - cmdit_new_floor.avg
#   single-pass proof: dispatch_after_verb.avg ~= dispatch_before_verb.avg
# cmdit_new allocs ~3 KB (~8.9 KB before 1.4.0) into a free-less bump allocator, so the
# alloc-heavy benches run a bounded 4096 iters, not a 1e6 loop; the pure leaves
# (get_enum, dispatch) run high iteration counts to amortize the ~240ns clock pair.
include "lib/vec.cyr"
include "lib/args.cyr"      # pulls alloc + syscalls (alloc_init / the synthetic argv arrays)
include "lib/string.cyr"
include "lib/fmt.cyr"       # bench_report number formatting
include "lib/io.cyr"
include "lib/bench.cyr"
include "src/cmdit.cyr"

var BOUND = 4096;           # alloc-heavy bench iters (a fresh ~3 KB handle each)
var HOT = 1000000;          # pure-leaf bench iters (no per-iter alloc)
var DISP = 200000;          # dispatch bench iters (~40B remainder alloc each)
var OUT = 20000;            # 1.4.0: output-path iters (no per-iter alloc)
var OUTC = 2000;            # 1.4.0: all three completion scripts per iter

# Run the cmdit micro-benchmarks (see docs/benchmarks.md for the methodology).
fn main(): i64 {
    alloc_init();

    # 1. cmdit_new_floor — the fixed per-handle construction floor: the allocs, zeroing
    #    the first 16 entries (1,920 B since 1.4.0; all 64, 7,680 B, before), and the 2
    #    auto registrations.
    var b1 = bench_new("cmdit_new_floor");
    bench_batch_start(b1);
    var i1 = 0;
    while (i1 < BOUND) { cmdit_new("b"); i1 = i1 + 1; }
    bench_batch_stop(b1, BOUND);
    bench_report(b1);

    # 2. setup_baseline — new + register the representative flag set, NO parse.
    #    Subtract from #3 to isolate the parse loop; from #1 to isolate register cost.
    var b2 = bench_new("setup_baseline");
    bench_batch_start(b2);
    var i2 = 0;
    while (i2 < BOUND) {
        var h = cmdit_new("b");
        cmdit_bool(h, 0, "loud", "");
        cmdit_int(h, 99, "count", 1, "");
        cmdit_str(h, 110, "name", 0, "");
        cmdit_enum(h, 0, "color", "auto", "auto|always|never", "");
        i2 = i2 + 1;
    }
    bench_batch_stop(b2, BOUND);
    bench_report(b2);

    # 3. parse_argv_mixed — the hot path: parse a representative argv exercising
    #    every token shape (long bool, short int+space, long str =value, enum,
    #    two positionals). Fresh handle each iter (parse mutates the handle).
    var av = alloc(9 * 8);
    store64(av + 0 * 8, "prog"); store64(av + 1 * 8, "--loud"); store64(av + 2 * 8, "-c");
    store64(av + 3 * 8, "5"); store64(av + 4 * 8, "--name=bob"); store64(av + 5 * 8, "--color");
    store64(av + 6 * 8, "always"); store64(av + 7 * 8, "f1"); store64(av + 8 * 8, "f2");
    var b3 = bench_new("parse_argv_mixed");
    bench_batch_start(b3);
    var i3 = 0;
    while (i3 < BOUND) {
        var h3 = cmdit_new("b");
        cmdit_bool(h3, 0, "loud", "");
        cmdit_int(h3, 99, "count", 1, "");
        cmdit_str(h3, 110, "name", 0, "");
        cmdit_enum(h3, 0, "color", "auto", "auto|always|never", "");
        cmdit_parse_argv(h3, 9, av);
        i3 = i3 + 1;
    }
    bench_batch_stop(b3, BOUND);
    bench_report(b3);

    # 4. get_enum_rewalk — the pure '|'-delimited choice scan re-walked on every
    #    cmdit_get_enum call (worst case = the last choice). No per-iter alloc.
    var he = cmdit_new("t");
    var fe = cmdit_enum(he, 0, "color", "auto", "auto|always|never", "");
    var ave = alloc(3 * 8); store64(ave, "p"); store64(ave + 8, "--color"); store64(ave + 16, "never");
    cmdit_parse_argv(he, 3, ave);
    var b4 = bench_new("get_enum_rewalk");
    bench_batch_start(b4);
    var i4 = 0;
    while (i4 < HOT) { cmdit_get_enum(he, fe); i4 = i4 + 1; }
    bench_batch_stop(b4, HOT);
    bench_report(b4);

    # 5. dispatch_before_verb — single-pass dispatch with the global flag BEFORE
    #    the verb (global resolve + verb-table scan + remainder compaction).
    var hd = cmdit_new("tool");
    cmdit_bool(hd, 0, "verbose", "");
    cmdit_verb(hd, "add", ""); cmdit_verb(hd, "remove", "");
    var avb = alloc(4 * 8);
    store64(avb, "tool"); store64(avb + 8, "--verbose");
    store64(avb + 16, "add"); store64(avb + 24, "x");
    var b5 = bench_new("dispatch_before_verb");
    bench_batch_start(b5);
    var i5 = 0;
    while (i5 < DISP) { cmdit_dispatch_argv(hd, 4, avb); i5 = i5 + 1; }
    bench_batch_stop(b5, DISP);
    bench_report(b5);

    # 6. dispatch_after_verb — same, global AFTER the verb. Should ~equal #5 (the
    #    payoff of resolving before-OR-after in ONE pass; a 2-scan impl would be ~2x).
    var ava = alloc(4 * 8);
    store64(ava, "tool"); store64(ava + 8, "add");
    store64(ava + 16, "--verbose"); store64(ava + 24, "x");
    var b6 = bench_new("dispatch_after_verb");
    bench_batch_start(b6);
    var i6 = 0;
    while (i6 < DISP) { cmdit_dispatch_argv(hd, 4, ava); i6 = i6 + 1; }
    bench_batch_stop(b6, DISP);
    bench_report(b6);

    # 7. repeat_accumulate — N=32 -H occurrences: lazy list alloc on first, O(1)
    #    push thereafter. Fresh handle each iter (the list is per-flag mutable state).
    var avr = alloc((1 + 32 * 2) * 8);
    store64(avr, "p");
    var rk = 0;
    while (rk < 32) { store64(avr + (1 + rk * 2) * 8, "-H"); store64(avr + (2 + rk * 2) * 8, "v"); rk = rk + 1; }
    var b7 = bench_new("repeat_accumulate_32");
    bench_batch_start(b7);
    var i7 = 0;
    while (i7 < BOUND) {
        var h7 = cmdit_new("b");
        cmdit_repeat(h7, 72, "header", "");
        cmdit_parse_argv(h7, 1 + 32 * 2, avr);
        i7 = i7 + 1;
    }
    bench_batch_stop(b7, BOUND);
    bench_report(b7);

    # 8. verb_new_floor — a verb tool's construction floor: cmdit_new + the first
    #    cmdit_verb, which allocates and zeroes the verb table: 16 rows of 48 B since
    #    1.4.0, all 128 (6,144 B) before. Subtract #1 for the verb table alone.
    var b8 = bench_new("verb_new_floor");
    bench_batch_start(b8);
    var i8 = 0;
    while (i8 < BOUND) {
        var h8 = cmdit_new("b");
        cmdit_verb(h8, "add", "");
        i8 = i8 + 1;
    }
    bench_batch_stop(b8, BOUND);
    bench_report(b8);

    # 9. flag_find_long — 1.3.7: cmdit_flag_find_long on the span of "color=never"
    #    up to the '=', the per-token question kriya's pre-parse expander asks. The
    #    flag is the last of the six on the handle, so this is the linear scan's
    #    worst case at that size, plus the span's NUL check. No per-iter alloc.
    var hf = cmdit_new("b");
    cmdit_bool(hf, 0, "loud", "");
    cmdit_int(hf, 99, "count", 1, "");
    cmdit_str(hf, 110, "name", 0, "");
    cmdit_enum(hf, 0, "color", "auto", "auto|always|never", "");
    var b9 = bench_new("flag_find_long");
    bench_batch_start(b9);
    var i9 = 0;
    while (i9 < HOT) { cmdit_flag_find_long(hf, "color=never", 5); i9 = i9 + 1; }
    bench_batch_stop(b9, HOT);
    bench_report(b9);

    # 10. flag_find_long_36 — 1.4.0: the same lookup on attn11's table, its 36 real long
    #     names (cmdit's ~35-flag sizing case), for the last one registered: the scan's
    #     worst case at that size, with first letters spread as a real tool's are.
    var h36 = cmdit_new("attn11");
    var nm36 = alloc(36 * 8);
    store64(nm36, "attn-every"); store64(nm36 + 8, "attn-kind"); store64(nm36 + 16, "bpe");
    store64(nm36 + 24, "corpus"); store64(nm36 + 32, "ctx"); store64(nm36 + 40, "d-model");
    store64(nm36 + 48, "decode-schedule"); store64(nm36 + 56, "decode-steps"); store64(nm36 + 64, "encode-shard");
    store64(nm36 + 72, "eval"); store64(nm36 + 80, "eval-corpus"); store64(nm36 + 88, "expert-topk");
    store64(nm36 + 96, "experts"); store64(nm36 + 104, "gen-only"); store64(nm36 + 112, "gpu");
    store64(nm36 + 120, "gpu-tc"); store64(nm36 + 128, "heads"); store64(nm36 + 136, "hearing");
    store64(nm36 + 144, "hearing-fd"); store64(nm36 + 152, "kv-heads"); store64(nm36 + 160, "latent-dim");
    store64(nm36 + 168, "layers"); store64(nm36 + 176, "load"); store64(nm36 + 184, "mtp");
    store64(nm36 + 192, "objective"); store64(nm36 + 200, "pos-kind"); store64(nm36 + 208, "preset");
    store64(nm36 + 216, "rope-dim"); store64(nm36 + 224, "save"); store64(nm36 + 232, "stdin");
    store64(nm36 + 240, "steps"); store64(nm36 + 248, "stream-corpus"); store64(nm36 + 256, "stream-encode");
    store64(nm36 + 264, "ternary"); store64(nm36 + 272, "vision"); store64(nm36 + 280, "vision-fd");
    var k36 = 0;
    while (k36 < 36) { cmdit_bool(h36, 0, load64(nm36 + k36 * 8), ""); k36 = k36 + 1; }
    var b10 = bench_new("flag_find_long_36");
    bench_batch_start(b10);
    var i10 = 0;
    while (i10 < HOT) { cmdit_flag_find_long(h36, "vision-fd", 9); i10 = i10 + 1; }
    bench_batch_stop(b10, HOT);
    bench_report(b10);

    # 11-13. 1.4.0: the output paths, written to /dev/null. Each renders the same handle
    #     the same way every iteration, so these measure the writing, mostly write(2).
    #     The stream is pointed at /dev/null only around the timed loop.
    var ho = cmdit_new("tool");
    cmdit_bool(ho, 118, "verbose", "be verbose");
    cmdit_str(ho, 114, "root", "/var/lib/tool", "storage root");
    cmdit_int(ho, 106, "jobs", 4, "parallel jobs");
    cmdit_enum(ho, 0, "color", "auto", "auto|always|never", "when to color");
    cmdit_repeat(ho, 72, "header", "extra header");
    var vo = cmdit_verb(ho, "run", "Run it (it's one-shot)");
    cmdit_verb(ho, "ps", "List things");
    var vro = cmdit_verb(ho, "rm", "Remove a thing");
    cmdit_verb_alias(ho, vro, "remove");
    var hvo = cmdit_new("tool run");
    cmdit_bool(hvo, 100, "detach", "run in the background");
    cmdit_verb_flags(ho, vo, hvo);
    var nul = syscall(2, "/dev/null", 1, 0);
    var b11 = bench_new("help_fd_devnull");
    bench_batch_start(b11);
    var i11 = 0;
    while (i11 < OUT) { cmdit_help_fd(ho, nul); i11 = i11 + 1; }
    bench_batch_stop(b11, OUT);
    bench_report(b11);

    var hpe = cmdit_new("tool");
    cmdit_enum(hpe, 0, "color", "auto", "auto|always|never", "");
    var ape = alloc(3 * 8); store64(ape, "tool"); store64(ape + 8, "--color=purple"); store64(ape + 16, 0);
    cmdit_parse_argv(hpe, 2, ape);
    var se2 = syscall(32, 2);
    syscall(33, nul, 2);
    var b12 = bench_new("print_error_devnull");
    bench_batch_start(b12);
    var i12 = 0;
    while (i12 < OUT) { cmdit_print_error(hpe); i12 = i12 + 1; }
    bench_batch_stop(b12, OUT);
    syscall(33, se2, 2);
    syscall(3, se2);
    bench_report(b12);

    var so1 = syscall(32, 1);
    syscall(33, nul, 1);
    var b13 = bench_new("completions_devnull");
    bench_batch_start(b13);
    var i13 = 0;
    while (i13 < OUTC) {
        cmdit_completions(ho, "bash");
        cmdit_completions(ho, "zsh");
        cmdit_completions(ho, "fish");
        i13 = i13 + 1;
    }
    bench_batch_stop(b13, OUTC);
    syscall(33, so1, 1);
    syscall(3, so1);
    bench_report(b13);

    return 0;
}

fn _entry(): i64 { var r = main(); sys_exit(r); return 0; }
_entry();
