# C5: remap / disable the auto -h / -V short letters
fn g012_c5_remap_disable_auto(): i64 {
    test_group("C5: remap / disable the auto -h / -V short letters");
    var h5a = cmdit_new("t"); cmdit_help_short(h5a, 63);                          # remap help to '?'
    var av5a = alloc(2 * 8); store64(av5a, "t"); store64(av5a + 8, "-?");
    assert(cmdit_parse_argv(h5a, 2, av5a) == CMDIT_HELP, "remapped -? -> CMDIT_HELP");
    var h5a2 = cmdit_new("t"); cmdit_help_short(h5a2, 63);
    var av5a2 = alloc(2 * 8); store64(av5a2, "t"); store64(av5a2 + 8, "--help");
    assert(cmdit_parse_argv(h5a2, 2, av5a2) == CMDIT_HELP, "--help long form survives the remap");
    var h5b = cmdit_new("t"); cmdit_help_short(h5b, 0);                           # disable -h, free it
    var fh5 = cmdit_bool(h5b, 104, "human", "");                                  # consumer's own -h
    var av5b = alloc(2 * 8); store64(av5b, "t"); store64(av5b + 8, "-h");
    assert(cmdit_parse_argv(h5b, 2, av5b) == CMDIT_OK, "-h no longer triggers help");
    assert(cmdit_get_bool(h5b, fh5) == 1, "consumer -h bool matched (not shadowed)");
    var h5b2 = cmdit_new("t"); cmdit_help_short(h5b2, 0);
    var av5b2 = alloc(2 * 8); store64(av5b2, "t"); store64(av5b2 + 8, "--help");
    assert(cmdit_parse_argv(h5b2, 2, av5b2) == CMDIT_HELP, "--help still fires with short disabled");
    var h5c = cmdit_new("t"); cmdit_version_short(h5c, 118);                      # remap version to '-v'
    var av5c = alloc(2 * 8); store64(av5c, "t"); store64(av5c + 8, "-v");
    assert(cmdit_parse_argv(h5c, 2, av5c) == CMDIT_VERSION, "remapped -v -> CMDIT_VERSION");
    return 0;
}

# defaults: absent flag keeps its registered default
