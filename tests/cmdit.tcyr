# error: non-numeric int -> BAD_INT
fn g007_error_non_numeric_int(): i64 {
    test_group("error: non-numeric int -> BAD_INT");
    var h7 = cmdit_new("t");
    var c7 = cmdit_int(h7, 99, "count", 1, "");
    var av7 = alloc(3 * 8); store64(av7, "t"); store64(av7 + 8, "-c"); store64(av7 + 16, "abc");
    assert(cmdit_parse_argv(h7, 3, av7) == CMDIT_RESULT_ERR, "bad int -> RESULT_ERR");
    assert(cmdit_error(h7) == CMDIT_ERR_BAD_INT, "error code = BAD_INT");
    return 0;
}

# error: int overflow rejected, not wrapped (no range bypass)
fn g008_error_int_overflow_rejected(): i64 {
    test_group("error: int overflow rejected, not wrapped (no range bypass)");
    var h7o = cmdit_new("t");
    var c7o = cmdit_int(h7o, 99, "count", 1, "");
    # 2^64+1 — a naive n=n*10+d accumulator would wrap to 1 and look valid.
    var av7o = alloc(3 * 8); store64(av7o, "t"); store64(av7o + 8, "-c"); store64(av7o + 16, "18446744073709551617");
    assert(cmdit_parse_argv(h7o, 3, av7o) == CMDIT_RESULT_ERR, "overflowing int -> RESULT_ERR");
    assert(cmdit_error(h7o) == CMDIT_ERR_BAD_INT, "overflow reported as BAD_INT");
    # the range-bypass it used to enable: wrap-to-1 would have passed 1..4096.
    var h7r = cmdit_new("t");
    var c7r = cmdit_int(h7r, 0, "width", 80, ""); cmdit_range(h7r, c7r, 1, 4096);
    var av7r = alloc(3 * 8);
    store64(av7r, "t"); store64(av7r + 8, "--width");
    store64(av7r + 16, "18446744073709551617");
    assert(cmdit_parse_argv(h7r, 3, av7r) == CMDIT_RESULT_ERR, "overflow cannot wrap into range");
    assert(cmdit_get_int(h7r, c7r) == 80, "default kept (no wrapped value stored)");
    # boundary: the largest valid i64 still parses (overflow guard is not off-by-one).
    var h7m = cmdit_new("t");
    var c7m = cmdit_int(h7m, 99, "count", 1, "");
    var av7m = alloc(3 * 8); store64(av7m, "t"); store64(av7m + 8, "-c"); store64(av7m + 16, "9223372036854775807");
    assert(cmdit_parse_argv(h7m, 3, av7m) == CMDIT_OK, "i64 max still accepted");
    assert(cmdit_get_int(h7m, c7m) == 9223372036854775807, "i64 max value stored exactly");
    return 0;
}

