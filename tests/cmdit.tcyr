    assert(cstreq(cmdit_get_str(hv7, g7), "c.toml") == 1, "--config consumed its value");
    assert(cmdit_verb_matched(hv7) == a7, "verb = add");
    return 0;
}

# verb: an unknown flag AFTER the verb goes to the remainder
fn g052_verb_unknown_flag_after(): i64 {
    test_group("verb: unknown flag AFTER verb is deferred to the remainder");   #skip-lint
    var hv8 = cmdit_new("t");
    var g8 = cmdit_bool(hv8, 0, "verbose", ""); cmdit_verb(hv8, "add", "");
    var dv8 = alloc(4 * 8);
    store64(dv8, "t"); store64(dv8 + 8, "add");
    store64(dv8 + 16, "--force"); store64(dv8 + 24, "x");
    assert(cmdit_dispatch_argv(hv8, 4, dv8) == CMDIT_OK, "dispatch OK");
    assert(cmdit_get_bool(hv8, g8) == 0, "global --verbose untouched");
    assert(cmdit_verb_argc(hv8) == 3, "remainder = [add, --force, x]");
    assert(cstreq(load64(cmdit_verb_argv(hv8) + 8), "--force") == 1, "remainder[1] = --force");
    return 0;
}

# verb: help BEFORE the verb -> CMDIT_HELP; AFTER the verb, it is the verb's
fn g053_verb_help_before_verb(): i64 {
    test_group("verb: help BEFORE verb -> CMDIT_HELP; AFTER verb -> deferred");   #skip-lint
    var hv9 = cmdit_new("t");
    cmdit_verb(hv9, "add", "");
    var dv9 = alloc(2 * 8); store64(dv9, "t"); store64(dv9 + 8, "--help");
    assert(cmdit_dispatch_argv(hv9, 2, dv9) == CMDIT_HELP, "--help before verb -> CMDIT_HELP");
    var hv9b = cmdit_new("t");
    cmdit_verb(hv9b, "add", "");
    var dv9b = alloc(3 * 8); store64(dv9b, "t"); store64(dv9b + 8, "add"); store64(dv9b + 16, "--help");
    assert(cmdit_dispatch_argv(hv9b, 3, dv9b) == CMDIT_OK, "--help after verb -> OK (deferred)");   #skip-lint
    assert(cmdit_verb_argc(hv9b) == 2, "remainder = [add, --help] for verb scope");
    return 0;
}

# verb: '--' before verb still lets the next token be the verb
fn g054_verb_before_verb_still(): i64 {
    test_group("verb: '--' before verb still lets the next token be the verb");
    var hv10 = cmdit_new("t");
    var a10 = cmdit_verb(hv10, "add", "");
    var dv10 = alloc(3 * 8); store64(dv10, "t"); store64(dv10 + 8, "--"); store64(dv10 + 16, "add");
    assert(cmdit_dispatch_argv(hv10, 3, dv10) == CMDIT_OK, "dispatch OK");
    assert(cmdit_verb_matched(hv10) == a10, "verb = add after --");
    return 0;
}

# verb: re-parse the remainder in a per-verb handle
fn g055_verb_re_parse_remainder(): i64 {
    test_group("verb: re-parse the remainder in a per-verb handle");
    var hp1 = cmdit_new("tool");
    cmdit_verb(hp1, "add", "");
    var dp1 = alloc(5 * 8);
    store64(dp1, "tool"); store64(dp1 + 8, "add"); store64(dp1 + 16, "--name");
    store64(dp1 + 24, "bob"); store64(dp1 + 32, "file.txt");
    assert(cmdit_dispatch_argv(hp1, 5, dp1) == CMDIT_OK, "dispatch OK");
    assert(cmdit_verb_argc(hp1) == 4, "remainder = [add, --name, bob, file.txt]");
    var vh1 = cmdit_new("tool add");
    var vn1 = cmdit_str(vh1, 0, "name", 0, "");
    assert(cmdit_parse_verb(vh1, hp1) == CMDIT_OK, "verb scope parse OK");
    assert(cstreq(cmdit_get_str(vh1, vn1), "bob") == 1, "verb flag --name = bob");
    assert(cmdit_positional_count(vh1) == 1, "verb positional captured");
    assert(cstreq(cmdit_positional(vh1, 0), "file.txt") == 1, "verb positional = file.txt");
    return 0;
}

# verb: nested sub-verb via re-entry on the remainder
fn g056_verb_nested_sub_verb(): i64 {
    test_group("verb: nested sub-verb via re-entry on the remainder");
    var hn = cmdit_new("tool");
    cmdit_verb(hn, "remote", "");
    var dn = alloc(4 * 8);
    store64(dn, "tool"); store64(dn + 8, "remote");
    store64(dn + 16, "add"); store64(dn + 24, "origin");
    assert(cmdit_dispatch_argv(hn, 4, dn) == CMDIT_OK, "parent dispatch OK");
    var sh = cmdit_new("tool remote");
    var sv_add = cmdit_verb(sh, "add", "");
    assert(cmdit_dispatch_argv(sh, cmdit_verb_argc(hn), cmdit_verb_argv(hn)) == CMDIT_OK, "sub dispatch OK");
    assert(cmdit_verb_matched(sh) == sv_add, "sub verb = add");
    assert(cmdit_verb_argc(sh) == 2, "sub remainder = [add, origin]");
    assert(cstreq(load64(cmdit_verb_argv(sh) + 8), "origin") == 1, "sub remainder[1] = origin");
    return 0;
}

# require_positionals: count gate
fn g057_require_positionals_count_gate(): i64 {
    test_group("require_positionals: count gate");
    var hpp = cmdit_new("t");
    var dpp = alloc(3 * 8); store64(dpp, "t"); store64(dpp + 8, "a"); store64(dpp + 16, "b");
    assert(cmdit_parse_argv(hpp, 3, dpp) == CMDIT_OK, "parse OK (2 positionals)");
    assert(cmdit_require_positionals(hpp, 2) == CMDIT_OK, "min 2 satisfied");
    assert(cmdit_require_positionals(hpp, 3) == CMDIT_RESULT_ERR, "min 3 not met -> err");
    assert(cmdit_error(hpp) == CMDIT_ERR_MISSING_POSITIONAL, "error = MISSING_POSITIONAL");
    return 0;
}

# C1: require_positionals_max / _exact upper-bound + exact gates
fn g058_c1_require_positionals_max(): i64 {
    test_group("C1: require_positionals_max / _exact upper-bound + exact gates");
    var hpm = cmdit_new("t");
    var dpm = alloc(3 * 8); store64(dpm, "t"); store64(dpm + 8, "a"); store64(dpm + 16, "b");
    assert(cmdit_parse_argv(hpm, 3, dpm) == CMDIT_OK, "parse OK (2 positionals)");
    assert(cmdit_require_positionals_max(hpm, 2) == CMDIT_OK, "max 2 satisfied (== boundary)");
    assert(cmdit_require_positionals_max(hpm, 3) == CMDIT_OK, "max 3 satisfied (under)");
    assert(cmdit_require_positionals_max(hpm, 1) == CMDIT_RESULT_ERR, "max 1 exceeded -> err");
    assert(cmdit_error(hpm) == CMDIT_ERR_TOO_MANY_POSITIONAL, "error = TOO_MANY_POSITIONAL");
    assert(cmdit_print_error(hpm) == CMDIT_EXIT_USAGE, "print_error TOO_MANY -> EXIT_USAGE");
    assert(cmdit_require_positionals_exact(hpm, 2) == CMDIT_OK, "exact 2 satisfied");
    assert(cmdit_require_positionals_exact(hpm, 3) == CMDIT_RESULT_ERR, "exact 3 (too few) -> err");
    assert(cmdit_error(hpm) == CMDIT_ERR_MISSING_POSITIONAL, "too few -> MISSING_POSITIONAL");
    assert(cmdit_require_positionals_exact(hpm, 1) == CMDIT_RESULT_ERR, "exact 1 (too many) -> err");
    assert(cmdit_error(hpm) == CMDIT_ERR_TOO_MANY_POSITIONAL, "too many -> TOO_MANY_POSITIONAL");
    return 0;
}

# verb: global required satisfied at finalize after dispatch
fn g059_verb_global_required_satisfied(): i64 {
    test_group("verb: global required satisfied at finalize after dispatch");
    var hgr = cmdit_new("t");
    var gr = cmdit_str(hgr, 0, "config", 0, ""); cmdit_required(hgr, gr); cmdit_verb(hgr, "add", "");
    var dgr = alloc(2 * 8); store64(dgr, "t"); store64(dgr + 8, "add");
    assert(cmdit_dispatch_argv(hgr, 2, dgr) == CMDIT_OK, "dispatch OK");
    assert(cmdit_finalize(hgr) == CMDIT_RESULT_ERR, "missing global required -> finalize err");
    assert(cmdit_error(hgr) == CMDIT_ERR_REQUIRED_MISSING, "error = REQUIRED_MISSING");
    return 0;
}

# --- audit-identified coverage gaps --------------------------------------

# parse: negative int value (the sign branch of _cmdit_parse_int)
fn g060_parse_negative_int_value(): i64 {
    test_group("parse: negative int value (the sign branch of _cmdit_parse_int)");
    var hni = cmdit_new("t");
    var cni = cmdit_int(hni, 99, "count", 0, "");
    var avni = alloc(2 * 8); store64(avni, "t"); store64(avni + 8, "--count=-5");
    assert(cmdit_parse_argv(hni, 2, avni) == CMDIT_OK, "--count=-5 parse OK");
    assert(cmdit_get_int(hni, cni) == 0 - 5, "negative int attached form -> -5");
    var hni2 = cmdit_new("t");
    var cni2 = cmdit_int(hni2, 99, "count", 0, "");
    var avni2 = alloc(3 * 8); store64(avni2, "t"); store64(avni2 + 8, "--count"); store64(avni2 + 16, "-42");
    assert(cmdit_parse_argv(hni2, 3, avni2) == CMDIT_OK, "--count -42 parse OK");
    assert(cmdit_get_int(hni2, cni2) == 0 - 42, "negative int space form -> -42");
    return 0;
}

