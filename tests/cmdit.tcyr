    assert(cmdit_parse_argv(huz, 2, avuz) == CMDIT_RESULT_ERR, "unknown short -> RESULT_ERR");
    assert(cmdit_error(huz) == CMDIT_ERR_UNKNOWN, "error = UNKNOWN");
    return 0;
}

# error: short value flag missing its value -> MISSING_VALUE + err_flag
fn g062_error_short_value_flag(): i64 {
    test_group("error: short value flag missing its value -> MISSING_VALUE + err_flag");
    var hsm = cmdit_new("t");
    var csm = cmdit_int(hsm, 99, "count", 1, "");
    var avsm = alloc(2 * 8); store64(avsm, "t"); store64(avsm + 8, "-c");
