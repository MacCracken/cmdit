    return 0;
}

# parse: cmdit_new(0) adopts argv[0] as the prog name
fn g067_parse_cmdit_new_0(): i64 {
    test_group("parse: cmdit_new(0) adopts argv[0] as the prog name");
    var hn0 = cmdit_new(0);
    var an0 = alloc(2 * 8); store64(an0, "myprog"); store64(an0 + 8, "x");
    assert(cmdit_parse_argv(hn0, 2, an0) == CMDIT_OK, "parse OK with null prog");
    assert(cstreq(load64(hn0 + 48), "myprog") == 1, "prog_name adopted from argv[0]");
    return 0;
}

# limit: registering past CMDIT_FLAGS_MAX returns -1 (no overrun)
fn g068_limit_registering_past_cmdit(): i64 {
    test_group("limit: registering past CMDIT_FLAGS_MAX returns -1 (no overrun)");
    var hcap = cmdit_new("t");                          # already used 2 slots (help/version)
    var k = 0;
    var lastok = 0;
    while (k < 62) { lastok = cmdit_bool(hcap, 0, 0, ""); k = k + 1; }
    assert(lastok == 63, "64th registration (idx 63) succeeds");
    assert(cmdit_bool(hcap, 0, 0, "") == 0 - 1, "65th registration -> -1 (cap enforced)");
    return 0;
}

# limit: registering past CMDIT_VERB_MAX returns -1
fn g069_limit_registering_past_cmdit(): i64 {
    test_group("limit: registering past CMDIT_VERB_MAX returns -1");
    var hvc = cmdit_new("t");
    var vk = 0;
    var vlast = 0;
    while (vk < 128) { vlast = cmdit_verb(hvc, "v", ""); vk = vk + 1; }
    assert(vlast == 127, "128th verb (id 127) succeeds");
    assert(cmdit_verb(hvc, "v", "") == 0 - 1, "129th verb -> -1 (cap enforced)");
    return 0;
}

# --- output renderers ----------------------------------------------------
# These assert the documented return code AND, more importantly, that the
# pointer-heavy render paths (raw entry/verb-row offsets, the sbuf[2] short
# buffer, the choice-set + Commands tails) execute without OOB. They emit to
# stdout/stderr by design — that output noise is expected during the run.

# render: cmdit_help renders every flag kind + the verb tail
fn g070_render_cmdit_help_renders(): i64 {
    test_group("render: cmdit_help renders every flag kind + the verb tail");
    var rh = cmdit_new("tool");
    cmdit_bool(rh, 118, "verbose", "be verbose");                              # -v / --verbose
    var rhn = cmdit_int(rh, 110, "num", 1, "a number"); cmdit_range(rh, rhn, 1, 10);   # -n / --num
    cmdit_str(rh, 111, "out", 0, "output path");                               # -o / --out
    cmdit_enum(rh, 0, "color", "auto", "auto|always|never", "when to colorize");
    cmdit_repeat(rh, 72, "header", "repeatable header");                       # -H / --header
    var rhq = cmdit_str(rh, 0, "handle", 0, "required handle"); cmdit_required(rh, rhq);
    cmdit_verb(rh, "add", "add a thing");
    var rhrm = cmdit_verb(rh, "remove", "remove a thing");
    cmdit_verb_alias(rh, rhrm, "rm");
    assert(cmdit_help(rh) == 0, "cmdit_help: short+long/<enum>/<int>/<str>/.../(required) + Commands");
    assert(cmdit_help_flags(rh) == 0, "cmdit_help_flags: just the flag rows (no Usage/Options/Commands wrapper)");
    return 0;
}

# render: cmdit_verbs_help lists real verbs, skips alias rows
fn g071_render_cmdit_verbs_help(): i64 {
    test_group("render: cmdit_verbs_help lists real verbs, skips alias rows");
    var rvh = cmdit_new("tool");
    cmdit_verb(rvh, "add", "add a thing");
    var rvrm = cmdit_verb(rvh, "remove", "remove a thing");
    cmdit_verb_alias(rvh, rvrm, "rm");
    assert(cmdit_verbs_help(rvh) == 0, "cmdit_verbs_help renders (alias 'rm' skipped)");
    return 0;
}

# render: cmdit_version line + null prog/version branches
fn g072_render_cmdit_version_line(): i64 {
    test_group("render: cmdit_version line + null prog/version branches");
    var rver = cmdit_new("tool");
    assert(cmdit_version(rver, "tool 1.0") == CMDIT_EXIT_OK, "cmdit_version -> EXIT_OK");
    var rver0 = cmdit_new(0);                                                  # prog_name = 0
    assert(cmdit_version(rver0, 0) == CMDIT_EXIT_OK, "cmdit_version(null prog, null ver) -> EXIT_OK");
    return 0;
}

# render: cmdit_print_error -> EXIT_USAGE for every error code
fn g073_render_cmdit_print_error(): i64 {
    test_group("render: cmdit_print_error -> EXIT_USAGE for every error code");
    var pe1 = cmdit_new("prog");                                              # UNKNOWN (generic, no flag)
    var pav1 = alloc(2 * 8); store64(pav1, "prog"); store64(pav1 + 8, "--nope");
    cmdit_parse_argv(pe1, 2, pav1);
    assert(cmdit_print_error(pe1) == CMDIT_EXIT_USAGE, "UNKNOWN -> EXIT_USAGE");
    var pe2 = cmdit_new("prog");                                              # MISSING_VALUE (names --long)
    cmdit_str(pe2, 0, "name", 0, "");
    var pav2 = alloc(2 * 8); store64(pav2, "prog"); store64(pav2 + 8, "--name");
    cmdit_parse_argv(pe2, 2, pav2);
    assert(cmdit_print_error(pe2) == CMDIT_EXIT_USAGE, "MISSING_VALUE -> EXIT_USAGE");
    var pe3 = cmdit_new("prog");                                              # BAD_INT via SHORT-only flag (sbuf path)
    cmdit_int(pe3, 99, 0, 1, "");
    var pav3 = alloc(3 * 8); store64(pav3, "prog"); store64(pav3 + 8, "-c"); store64(pav3 + 16, "abc");
    cmdit_parse_argv(pe3, 3, pav3);
    assert(cmdit_print_error(pe3) == CMDIT_EXIT_USAGE, "BAD_INT (short flag named via sbuf) -> EXIT_USAGE");
    var pe4 = cmdit_new("prog");                                              # BUNDLED (generic)
    var pav4 = alloc(2 * 8); store64(pav4, "prog"); store64(pav4 + 8, "-xy");
    cmdit_parse_argv(pe4, 2, pav4);
    assert(cmdit_print_error(pe4) == CMDIT_EXIT_USAGE, "BUNDLED -> EXIT_USAGE");
    var pe5 = cmdit_new("prog");                                              # BAD_ENUM (+ choice set tail)
    cmdit_enum(pe5, 0, "color", "auto", "auto|always|never", "");
    var pav5 = alloc(3 * 8); store64(pav5, "prog"); store64(pav5 + 8, "--color"); store64(pav5 + 16, "purple");
    cmdit_parse_argv(pe5, 3, pav5);
    assert(cmdit_print_error(pe5) == CMDIT_EXIT_USAGE, "BAD_ENUM (+expected set) -> EXIT_USAGE");
    var pe6 = cmdit_new("prog");                                              # OUT_OF_RANGE
    var pe6f = cmdit_int(pe6, 0, "width", 80, ""); cmdit_range(pe6, pe6f, 1, 10);
    var pav6 = alloc(3 * 8); store64(pav6, "prog"); store64(pav6 + 8, "--width"); store64(pav6 + 16, "99");
    cmdit_parse_argv(pe6, 3, pav6);
    assert(cmdit_print_error(pe6) == CMDIT_EXIT_USAGE, "OUT_OF_RANGE -> EXIT_USAGE");
    var pe7 = cmdit_new("prog");                                              # REQUIRED_MISSING (via finalize)
    var pe7f = cmdit_str(pe7, 0, "handle", 0, ""); cmdit_required(pe7, pe7f);
    var pav7 = alloc(1 * 8); store64(pav7, "prog");
    cmdit_parse_argv(pe7, 1, pav7); cmdit_finalize(pe7);
    assert(cmdit_print_error(pe7) == CMDIT_EXIT_USAGE, "REQUIRED_MISSING -> EXIT_USAGE");
    var pe8 = cmdit_new("prog");                                              # UNKNOWN_VERB (+ token + Commands tail)
    cmdit_verb(pe8, "add", "add a thing");
    var pav8 = alloc(2 * 8); store64(pav8, "prog"); store64(pav8 + 8, "bogus");
    cmdit_dispatch_argv(pe8, 2, pav8);
    assert(cmdit_print_error(pe8) == CMDIT_EXIT_USAGE, "UNKNOWN_VERB (+command list) -> EXIT_USAGE");
    var pe9 = cmdit_new("prog");                                              # MISSING_POSITIONAL
    var pav9 = alloc(1 * 8); store64(pav9, "prog");
    cmdit_parse_argv(pe9, 1, pav9); cmdit_require_positionals(pe9, 2);
    assert(cmdit_print_error(pe9) == CMDIT_EXIT_USAGE, "MISSING_POSITIONAL -> EXIT_USAGE");
    var pe10 = cmdit_new("prog");                                             # else: unrecognized code (defensive)
    # force a bogus last_error -> the "argument error" fallback arm
    store64(pe10 + 56, 99);
    assert(cmdit_print_error(pe10) == CMDIT_EXIT_USAGE, "unrecognized code -> argument error -> EXIT_USAGE");
    return 0;
}

# ══ 1.2.0: verb introspection + completions ══════════
# verb_introspection
fn g074_verb_introspection(): i64 {
    test_group("verb_introspection");
    var vi = cmdit_new("demo");
    assert(cmdit_verb_count(vi) == 0, "no verbs registered -> count 0");
    assert(cmdit_verb_name_at(vi, 0) == 0, "name_at on an empty table -> 0");
    var v_run = cmdit_verb(vi, "run", "Run a thing");
    var v_ls = cmdit_verb(vi, "ls", "List things");
    cmdit_verb_alias(vi, v_run, "r");
    assert(cmdit_verb_count(vi) == 3, "two verbs + one alias -> 3 rows");
    assert(cstreq(cmdit_verb_name_at(vi, 0), "run") == 1, "row 0 name");
    assert(cstreq(cmdit_verb_name_at(vi, 1), "ls") == 1, "row 1 name");
    assert(cstreq(cmdit_verb_name_at(vi, 2), "r") == 1, "row 2 is the alias");
    assert(cmdit_verb_is_alias(vi, 0) == 0, "row 0 is canonical");
    assert(cmdit_verb_is_alias(vi, 2) == 1, "row 2 is an alias");
    assert(cmdit_verb_canonical_at(vi, 2) == v_run, "alias resolves to its verb");
    assert(cstreq(cmdit_verb_help_at(vi, 0), "Run a thing") == 1, "canonical help");
    # An alias row stores no help of its own; it must borrow the canonical's,
    # or a caller listing aliases would show a blank description.
    assert(cstreq(cmdit_verb_help_at(vi, 2), "Run a thing") == 1, "alias borrows canonical help");
    # Out-of-range is 0 / -1, never a wild read.
    assert(cmdit_verb_name_at(vi, 99) == 0, "name_at out of range -> 0");
    assert(cmdit_verb_name_at(vi, 0 - 1) == 0, "name_at negative -> 0");
    assert(cmdit_verb_is_alias(vi, 99) == 0, "is_alias out of range -> 0");
    assert(cmdit_verb_canonical_at(vi, 99) == 0 - 1, "canonical_at out of range -> -1");
    assert(cmdit_verb_count(0) == 0, "null handle -> 0");
    return 0;
}

# completions
fn g075_completions(): i64 {
    test_group("completions");
    # Only the shell selection and the failure contract are asserted here — the
    # script bodies go to stdout, which this harness does not capture. The
    # generated text is covered by the fuzz/program probes.
    var ch = cmdit_new("demo");
    cmdit_verb(ch, "run", "Run a thing");
    assert(cmdit_completions(ch, "elvish") == 0 - 1, "unknown shell -> -1");
    assert(cmdit_completions(ch, 0) == 0 - 1, "null shell -> -1");
    assert(cmdit_completions(0, "bash") == 0 - 1, "null handle -> -1");
    return 0;
}

# ══ 1.2.4 audit fixes ══════════════════════
# Every assertion below fails against 1.2.3. See CHANGELOG [1.2.4].

# 1.2.4 security: shell command-word alphabet
fn g076_1_2_4_security(): i64 {
    test_group("1.2.4 security: shell command-word alphabet");
    # Exhaustive over every byte value, so the whitelist cannot be widened by
    # accident. A generated completion script is SOURCED by the user's shell,
    # so a byte reaching it verbatim is code.
    var bc = 0;
    var allowed = 0;
    while (bc < 256) {
        var want = 0;
        if (bc >= 48 && bc <= 57) { want = 1; }
        if (bc >= 65 && bc <= 90) { want = 1; }
        if (bc >= 97 && bc <= 122) { want = 1; }
        if (bc == 95 || bc == 46 || bc == 45) { want = 1; }
        if (_cmdit_is_cmdname_byte(bc) != want) { allowed = allowed + 1; }
        bc = bc + 1;
    }
    assert(allowed == 0, "cmdname alphabet is exactly [A-Za-z0-9_.-] over all 256 bytes");
    # The bytes that actually turn a name into a command, called out by name so
    # a regression reads as what it is rather than as an off-by-one in a loop.
    assert(_cmdit_is_cmdname_byte(10) == 0, "newline rejected (ends the comment, starts a command)");
    assert(_cmdit_is_cmdname_byte(36) == 0, "$ rejected (expansion)");
    assert(_cmdit_is_cmdname_byte(96) == 0, "backtick rejected (substitution)");
    assert(_cmdit_is_cmdname_byte(39) == 0, "single quote rejected");
    assert(_cmdit_is_cmdname_byte(34) == 0, "double quote rejected");
    assert(_cmdit_is_cmdname_byte(59) == 0, "; rejected");
    assert(_cmdit_is_cmdname_byte(38) == 0, "& rejected");
    assert(_cmdit_is_cmdname_byte(124) == 0, "| rejected");
    assert(_cmdit_is_cmdname_byte(32) == 0, "space rejected (word split)");
    assert(_cmdit_is_cmdname_byte(40) == 0, "( rejected");
    assert(_cmdit_is_cmdname_byte(62) == 0, "> rejected (redirect)");
    assert(_cmdit_is_cmdname_byte(0) == 0, "NUL rejected");
    assert(_cmdit_name_is_safe("tool\ntouch /tmp/x") == 0, "injected prog name is not safe");
    assert(_cmdit_name_is_safe("cmdit-smoke") == 1, "an ordinary hyphenated name stays safe");
    assert(_cmdit_name_is_safe("foo.sh") == 1, "a dotted name stays safe");
    return 0;
}

# 1.2.4 memory safety: modifier idx guards
fn g077_1_2_4_memory(): i64 {
    test_group("1.2.4 memory safety: modifier idx guards");
    # The 1.0.0 audit guarded the GETTERS. The modifiers kept only `idx < 0`,
    # so an out-of-range idx was an out-of-bounds WRITE: cmdit_required(h, 64)
    # read-modify-wrote entries+7216, which the bump allocator places 48 bytes
    # into the positional array, corrupting a live cstr pointer.
    var gh = cmdit_new("t");
    var gav = alloc(9 * 8);
    store64(gav + 0*8, "t");
    store64(gav + 1*8, "p0"); store64(gav + 2*8, "p1"); store64(gav + 3*8, "p2");
    store64(gav + 4*8, "p3"); store64(gav + 5*8, "p4"); store64(gav + 6*8, "p5");
    store64(gav + 7*8, "p6"); store64(gav + 8*8, "p7");
    assert(cmdit_parse_argv(gh, 9, gav) == CMDIT_OK, "8 positionals parsed");
    var p6_before = cmdit_positional(gh, 6);
    assert(cmdit_required(gh, 64) == 0 - 1, "cmdit_required past the flag cap -> -1");
    assert(cmdit_positional(gh, 6) == p6_before, "positional[6] pointer not corrupted");
    assert(cstreq(cmdit_positional(gh, 6), "p6") == 1, "positional[6] still reads p6");
    assert(cmdit_range(gh, 999, 0, 10) == 0 - 1, "cmdit_range out of range -> -1");
    assert(cmdit_env(gh, 999, "HOME") == 0 - 1, "cmdit_env out of range -> -1");
    assert(cmdit_metavar(gh, 999, "F") == 0 - 1, "cmdit_metavar out of range -> -1");
    assert(cmdit_required(gh, 0 - 1) == 0 - 1, "cmdit_required(-1) still -1 (ignored registration)");
    return 0;
}

# 1.2.4 memory safety: repeat accessor idx guards
fn g078_1_2_4_memory(): i64 {
    test_group("1.2.4 memory safety: repeat accessor idx guards");
    # cmdit_repeat_get computed the entry pointer unchecked and then FOLLOWED
    # the list pointer read from it — not just an out-of-bounds read, a
    # dereference of whatever those bytes were.
    var r124h = cmdit_new("t");
    var rF = cmdit_repeat(r124h, 72, "header", "");
    var rav = alloc(3 * 8);
    store64(rav + 0*8, "t"); store64(rav + 1*8, "--header"); store64(rav + 2*8, "a");
    assert(cmdit_parse_argv(r124h, 3, rav) == CMDIT_OK, "repeat parse ok");
    assert(cmdit_repeat_count(r124h, rF) == 1, "one occurrence recorded");
    assert(cmdit_repeat_count(r124h, 999) == 0, "repeat_count out of range -> 0");
    assert(cmdit_repeat_count(r124h, 0 - 1) == 0, "repeat_count negative -> 0");
    assert(cmdit_repeat_get(r124h, 999, 0) == 0, "repeat_get out of range idx -> 0");
    assert(cmdit_repeat_get(r124h, 0 - 1, 0) == 0, "repeat_get negative idx -> 0");
    # A non-repeat flag has a 0 list pointer; asking for element 0 must not follow it.
    var rB = cmdit_bool(r124h, 0, "plain", "");
    assert(cmdit_repeat_get(r124h, rB, 0) == 0, "repeat_get on a non-repeat flag -> 0");
    return 0;
}

# 1.2.4 null-handle tolerance
fn g079_1_2_4_null(): i64 {
    test_group("1.2.4 null-handle tolerance");
    assert(cmdit_get_bool(0, 0) == 0, "get_bool(0) -> 0");
    assert(cmdit_get_int(0, 0) == 0, "get_int(0) -> 0");
    assert(cmdit_get_str(0, 0) == 0, "get_str(0) -> 0");
    assert(cmdit_get_enum(0, 0) == 0 - 1, "get_enum(0) -> -1");
    assert(cmdit_seen(0, 0) == 0, "seen(0) -> 0");
    assert(cmdit_repeat_count(0, 0) == 0, "repeat_count(0) -> 0");
    assert(cmdit_repeat_get(0, 0, 0) == 0, "repeat_get(0) -> 0");
    assert(cmdit_required(0, 0) == 0 - 1, "required(0) -> -1");
    assert(cmdit_range(0, 0, 0, 1) == 0 - 1, "range(0) -> -1");
    assert(cmdit_env(0, 0, "HOME") == 0 - 1, "env(0) -> -1");
    assert(cmdit_metavar(0, 0, "F") == 0 - 1, "metavar(0) -> -1");
    assert(cmdit_help_short(0, 120) == 0, "help_short(0) is a no-op, not a null write");
    assert(cmdit_version_short(0, 120) == 0, "version_short(0) is a no-op, not a null write");
    assert(cmdit_verb_trailing_after(0, 0, 1) == 0 - 1, "trailing_after(0) -> -1");
    return 0;
}

# 1.2.4 correctness: err_entry does not leak across parses
fn g080_1_2_4_correctness(): i64 {
    test_group("1.2.4 correctness: err_entry does not leak across parses");
    # cmdit_err_flag documents -1 for errors that name no registered flag
    # (UNKNOWN / BUNDLED). It held only on a virgin handle: err_entry was never
    # cleared, so a SECOND parse reported the FIRST parse's flag.
    var eh = cmdit_new("t");
    var eN = cmdit_str(eh, 110, "name", 0, "");
    var eav1 = alloc(2 * 8);
    store64(eav1 + 0*8, "t"); store64(eav1 + 1*8, "--name");        # missing value
    assert(cmdit_parse_argv(eh, 2, eav1) == CMDIT_RESULT_ERR, "first parse errors");
    assert(cmdit_error(eh) == CMDIT_ERR_MISSING_VALUE, "first error is MISSING_VALUE");
    assert(cmdit_err_flag(eh) == eN, "first error names --name");
    var eav2 = alloc(2 * 8);
    store64(eav2 + 0*8, "t"); store64(eav2 + 1*8, "--nope");        # unknown flag
    assert(cmdit_parse_argv(eh, 2, eav2) == CMDIT_RESULT_ERR, "second parse errors");
    assert(cmdit_error(eh) == CMDIT_ERR_UNKNOWN, "second error is UNKNOWN");
    assert(cmdit_err_flag(eh) == 0 - 1, "UNKNOWN names no flag (was: stale --name)");
    # Same for BUNDLED, which cmdit_print_error DOES prefix with the flag name.
    var eav3 = alloc(2 * 8);
    store64(eav3 + 0*8, "t"); store64(eav3 + 1*8, "-xy");
    assert(cmdit_parse_argv(eh, 2, eav3) == CMDIT_RESULT_ERR, "bundled parse errors");
    assert(cmdit_error(eh) == CMDIT_ERR_BUNDLED, "third error is BUNDLED");
    assert(cmdit_err_flag(eh) == 0 - 1, "BUNDLED names no flag (was: stale --name)");
    # A clean re-parse must clear the error entirely.
    var eav4 = alloc(3 * 8);
    store64(eav4 + 0*8, "t"); store64(eav4 + 1*8, "--name"); store64(eav4 + 2*8, "ok");
    assert(cmdit_parse_argv(eh, 3, eav4) == CMDIT_OK, "clean re-parse ok");
    assert(cmdit_error(eh) == CMDIT_ERR_NONE, "error reset by a clean parse");
    assert(cmdit_err_flag(eh) == 0 - 1, "err_flag reset by a clean parse");
    return 0;
}

# 1.2.4 input validation: trailing_after / negative argc
fn g081_1_2_4_input(): i64 {
    test_group("1.2.4 input validation: trailing_after / negative argc");
    var th = cmdit_new("t");
    var tv = cmdit_verb(th, "exec", "run in a container");
    assert(cmdit_verb_trailing_after(th, tv, 0 - 1) == 0 - 1, "trailing_after(-1) rejected");
    assert(cmdit_verb_trailing_at(th, tv) == 0 - 1, "rejected mark left the verb unmarked");
    assert(cmdit_verb_trailing_after(th, tv, 0 - 5) == 0 - 1, "trailing_after(-5) rejected");
    assert(cmdit_verb_trailing_at(th, tv) == 0 - 1, "still unmarked");
    assert(cmdit_verb_trailing_after(th, tv, 1) == tv, "trailing_after(1) accepted");
    assert(cmdit_verb_trailing_at(th, tv) == 1, "mark reads back as 1");
    assert(cmdit_verb_trailing_after(th, 999, 1) == 0 - 1, "trailing_after past the verb table -> -1");
    # A negative argc used to make alloc() return 0 and the NUL-terminator store
    # write to address 0.
    var dh = cmdit_new("t");
    cmdit_verb(dh, "go", "");
    var dav = alloc(2 * 8);
    store64(dav + 0*8, "t"); store64(dav + 1*8, "go");
    assert(cmdit_dispatch_argv(dh, 0 - 1, dav) == CMDIT_OK, "negative argc is clamped, not a null write");
    assert(cmdit_verb_matched(dh) == 0 - 1, "no verb matched from an empty argv");
    return 0;
}

# 1.3.0 argv materialization: one walk, same pointers
fn g082_1_3_0_argv(): i64 {
    test_group("1.3.0 argv materialization: one walk, same pointers");
    # The Linux cmdline layout: arguments end to end, each NUL-terminated, an
    # empty argument a bare NUL. "a\0\0bc\0-x\0" holds four of them.
    var fb = alloc(16);
    store8(fb + 0, 97); store8(fb + 1, 0);                         # "a"
    store8(fb + 2, 0);                                             # ""
    store8(fb + 3, 98); store8(fb + 4, 99); store8(fb + 5, 0);     # "bc"
    store8(fb + 6, 45); store8(fb + 7, 120); store8(fb + 8, 0);    # "-x"
    var fo = alloc(5 * 8);
    store64(fo + 4 * 8, 777);                                      # sentinel past the last slot
    assert(_cmdit_split_flat(fb, 4, fo) == 4, "split returns the count");
    assert(load64(fo + 0 * 8) == fb + 0, "arg 0 at offset 0");
    assert(load64(fo + 1 * 8) == fb + 2, "empty arg 1 is its own bare NUL");
    assert(load64(fo + 2 * 8) == fb + 3, "arg 2 starts after the empty arg");
    assert(load64(fo + 3 * 8) == fb + 6, "arg 3 at offset 6");
    assert(load64(fo + 4 * 8) == 777, "split writes exactly n slots");
    assert(_cmdit_split_flat(fb, 0, fo) == 0, "n = 0 writes nothing");
    # The live process argv: the materialized array must hold exactly the
    # pointers stdlib argv(i) returns, NULL-terminated.
    var lh = cmdit_new("t");
    var ln = cmdit_argv(lh);
    assert(ln == argc(), "materialized count is argc()");
    assert(ln >= 1, "the test process has at least argv[0]");
    var la = cmdit_raw_argv(lh);
    var li = 0;
    var lsame = 1;
    while (li < ln) {
        if (load64(la + li * 8) != argv(li)) { lsame = 0; }
        li = li + 1;
    }
    assert(lsame == 1, "every slot is pointer-identical to argv(i)");
    assert(load64(la + ln * 8) == 0, "materialized argv is NULL-terminated");
    assert(cmdit_argv(lh) == ln, "second call returns the cached count");
    return 0;
}

# 1.3.1 positionals grow past 128 (it used to drop the rest silently) (with the 1 group after it,
# which share its fixtures)
fn g083_1_3_1_positionals(): i64 {
    test_group("1.3.1 positionals grow past 128 (it used to drop the rest silently)");
    # `tool *.txt` over 1000 files: 1000 distinct positional pointers with a flag in
    # the middle, crossing three doublings (128 -> 256 -> 512 -> 1024).
    var npos = 1000;
    var pgh = cmdit_new("t");
    var gloud = cmdit_bool(pgh, 108, "loud", "");
    var pgav = alloc((npos + 2) * 8);
    var gvals = alloc(npos * 2);
    store64(pgav, "t");
    var gk = 0;
    var gslot = 1;
    while (gk < npos) {
        if (gk == 500) { store64(pgav + gslot * 8, "--loud"); gslot = gslot + 1; }
        store8(gvals + gk * 2, 102); store8(gvals + gk * 2 + 1, 0);
        store64(pgav + gslot * 8, gvals + gk * 2);
        gslot = gslot + 1;
        gk = gk + 1;
    }
    assert(cmdit_parse_argv(pgh, gslot, pgav) == CMDIT_OK, "1000 positionals + a flag parse OK");
    assert(cmdit_positional_count(pgh) == npos, "all 1000 counted");
    var gsame = 1;
    gk = 0;
    while (gk < npos) {
        if (cmdit_positional(pgh, gk) != gvals + gk * 2) { gsame = 0; }
        gk = gk + 1;
    }
    assert(gsame == 1, "every positional kept, in order, through three regrowths");
    assert(cmdit_positional(pgh, npos) == 0, "past the count -> 0");
    assert(load64(pgh + 32) == 1024, "capacity doubled to 1024, not regrown per push");
    assert(cmdit_get_bool(pgh, gloud) == 1, "the flag between positionals still applied");
    assert(cmdit_require_positionals_max(pgh, 999) == CMDIT_RESULT_ERR, "positionals_max(999) sees all 1000");
    assert(cmdit_require_positionals_exact(pgh, 1000) == CMDIT_OK, "positionals_exact(1000) holds");
    # Through verb re-entry: the remainder slice was never capped; the child is now too.
    var gvh = cmdit_new("t");
    cmdit_verb(gvh, "rm", "");
    store64(pgav + 8, "rm");                        # argv: t rm <positionals...>
    var gvr = cmdit_dispatch_argv(gvh, gslot, pgav);
    assert(gvr == CMDIT_OK, "dispatch with 999 trailing args OK");
    var gch = cmdit_new("t rm");
    cmdit_bool(gch, 108, "loud", "");
    assert(cmdit_parse_verb(gch, gvh) == CMDIT_OK, "verb scope parses them");
    assert(cmdit_positional_count(gch) == npos - 1, "verb scope keeps all 999");

    test_group("1.3.1 a refused growth is CMDIT_ERR_NOMEM, never a silent drop");
    # Unreachable through the public API (the sizes are far inside ALLOC_MAX), so the
    # handle is pushed to a capacity whose doubling alloc must refuse.
    var huge = 576460752303423488;                 # 2^59: doubling * 8 overflows
    assert(_cmdit_grow(gvals, 0, huge * 2) == 0, "_cmdit_grow reports a refused alloc as 0");
    assert(_cmdit_repeat_cap(0) == 64, "repeat cap starts at CMDIT_REPEAT_MAX");
    assert(_cmdit_repeat_cap(64) == 64, "repeat cap 64 holds 64");
    assert(_cmdit_repeat_cap(65) == 128, "repeat cap doubles past 64");
    assert(_cmdit_repeat_cap(300) == 512, "repeat cap covers 300 with 512");
    var nh = cmdit_new("t");
    store64(nh + 32, huge);                        # positional cap
    store64(nh + 40, huge);                        # positional count == cap -> must grow
    var nav = alloc(2 * 8); store64(nav, "t"); store64(nav + 8, "x");
    assert(cmdit_parse_argv(nh, 2, nav) == CMDIT_RESULT_ERR, "refused positional growth fails the parse");
    assert(cmdit_error(nh) == CMDIT_ERR_NOMEM, "positional growth failure -> NOMEM");
    assert(cmdit_err_flag(nh) == 0 - 1, "positional NOMEM names no flag");
    var nbuf = alloc(256);
    capture_print_error(nh, nbuf, 256);
    assert(cstreq(nbuf, "t: out of memory\n") == 1, "NOMEM renders as `out of memory`");
    var nrh = cmdit_new("t");
    var rf = cmdit_repeat(nrh, 72, "header", "");
    var nrav = alloc(3 * 8); store64(nrav, "t"); store64(nrav + 8, "-H"); store64(nrav + 16, "a");
    assert(cmdit_parse_argv(nrh, 3, nrav) == CMDIT_OK, "first -H allocates the list");
    store64(_cmdit_entry(nrh, rf) + 96, huge);      # repeat count at a doubling boundary
    assert(cmdit_parse_argv(nrh, 3, nrav) == CMDIT_RESULT_ERR, "refused repeat growth fails the parse");
    assert(cmdit_error(nrh) == CMDIT_ERR_NOMEM, "repeat growth failure -> NOMEM");
    assert(cmdit_err_flag(nrh) == rf, "repeat NOMEM names its flag");
    assert(cmdit_err_value(nrh) == 0, "repeat NOMEM rejected no value (1.3.3)");
    return 0;
}

# 1.3.1 a bool given =value is rejected (`--loud=0` used to turn it ON)
fn g084_1_3_1_bool(): i64 {
    test_group("1.3.1 a bool given =value is rejected (`--loud=0` used to turn it ON)");
    var bh = cmdit_new("prog");
    var bl = cmdit_bool(bh, 108, "loud", "");
    var bav = alloc(2 * 8); store64(bav, "prog"); store64(bav + 8, "--loud=0");
    assert(cmdit_parse_argv(bh, 2, bav) == CMDIT_RESULT_ERR, "--loud=0 is an error");
    assert(cmdit_error(bh) == CMDIT_ERR_UNEXPECTED_VALUE, "-> UNEXPECTED_VALUE");
    assert(cmdit_err_flag(bh) == bl, "names --loud");
    assert(cmdit_get_bool(bh, bl) == 0, "the flag was not set");
    assert(cmdit_seen(bh, bl) == 0, "and not marked seen");
    var bbuf = alloc(256);
    capture_print_error(bh, bbuf, 256);
    assert(cstreq(bbuf, "prog: --loud: option takes no value (got '0')\n") == 1,
      "renders `--loud: option takes no value (got '0')`");
    var bh2 = cmdit_new("prog");
    cmdit_bool(bh2, 108, "loud", "");
    store64(bav + 8, "--loud=");
    assert(cmdit_parse_argv(bh2, 2, bav) == CMDIT_RESULT_ERR, "an empty =value is still a value");
    var bh3 = cmdit_new("prog");
    var bl3 = cmdit_bool(bh3, 108, "loud", "");
    store64(bav + 8, "--loud");
    assert(cmdit_parse_argv(bh3, 2, bav) == CMDIT_OK, "bare --loud still OK");
    assert(cmdit_get_bool(bh3, bl3) == 1, "and sets the flag");
    var bh4 = cmdit_new("prog");
    store64(bav + 8, "--help=x");
    assert(cmdit_parse_argv(bh4, 2, bav) == CMDIT_RESULT_ERR, "--help=x is an error, not CMDIT_HELP");
    assert(cmdit_error(bh4) == CMDIT_ERR_UNEXPECTED_VALUE, "auto bools follow the same rule");
    # Dispatch path: a global bool before and after the verb.
    var bd = cmdit_new("prog");
    var bdv = cmdit_bool(bd, 0, "verbose", "");
    cmdit_verb(bd, "go", "");
    var bdav = alloc(3 * 8); store64(bdav, "prog"); store64(bdav + 8, "--verbose=1"); store64(bdav + 16, "go");
    assert(cmdit_dispatch_argv(bd, 3, bdav) == CMDIT_RESULT_ERR, "global --verbose=1 before the verb is an error");
    assert(cmdit_error(bd) == CMDIT_ERR_UNEXPECTED_VALUE, "-> UNEXPECTED_VALUE (before)");
    assert(cmdit_err_flag(bd) == bdv, "names --verbose (before)");
    var bd2 = cmdit_new("prog");
    cmdit_bool(bd2, 0, "verbose", "");
    cmdit_verb(bd2, "go", "");
    store64(bdav + 8, "go"); store64(bdav + 16, "--verbose=1");
    assert(cmdit_dispatch_argv(bd2, 3, bdav) == CMDIT_RESULT_ERR, "global --verbose=1 after the verb is an error");
    assert(cmdit_error(bd2) == CMDIT_ERR_UNEXPECTED_VALUE, "-> UNEXPECTED_VALUE (after)");
    # The env fallback keeps presence semantics: a set var turns a bool on.
    if (getenv("HOME") != 0) {
        var be = cmdit_new("prog");
        var bel = cmdit_bool(be, 0, "loud", "");
        cmdit_env(be, bel, "HOME");
        var beav = alloc(1 * 8); store64(beav, "prog");
        assert(cmdit_parse_argv(be, 1, beav) == CMDIT_OK, "env-bool parse OK");
        assert(cmdit_finalize(be) == CMDIT_OK, "env-bool finalize OK (no value check on env)");
        assert(cmdit_get_bool(be, bel) == 1, "a set env var still turns the bool on");
    }
    return 0;
}

# 1.2.4 security: emitters actually sanitise the program name
fn g085_1_2_4_security(): i64 {
    test_group("1.2.4 security: emitters actually sanitise the program name");
    # The end-to-end case. prog_name here is what argv[0] would be on the
    # documented cmdit_new(0) path, chosen by whoever execs the tool. Against
    # 1.2.3 the captured script contained a bare `touch /tmp/cmdit_pwned` line,
    # passed `bash -n`, and ran it on `source`.
    var evil = "tool\ntouch /tmp/cmdit_pwned\n#";
    var cbuf = alloc(8192);
    var xh = cmdit_new(evil);
    cmdit_verb(xh, "run", "run a thing");
    cmdit_int(xh, 114, "root", 0, "data root");

    var cn = capture_completions(xh, "bash", cbuf, 8192);
    assert(cn > 0, "bash completion captured");
    assert(contains(cbuf, "touch /tmp/cmdit_pwned") == 0, "bash: injected command absent");
    assert(contains(cbuf, "\n") == 1, "bash: script still has real newlines (capture is sane)");
    assert(contains(cbuf, "_complete") == 1, "bash: still a working completion");

    cn = capture_completions(xh, "zsh", cbuf, 8192);
    assert(cn > 0, "zsh completion captured");
    assert(contains(cbuf, "touch /tmp/cmdit_pwned") == 0, "zsh: injected command absent");
    assert(contains(cbuf, "#compdef") == 1, "zsh: still a working completion");

    cn = capture_completions(xh, "fish", cbuf, 8192);
    assert(cn > 0, "fish completion captured");
    assert(contains(cbuf, "touch /tmp/cmdit_pwned") == 0, "fish: injected command absent");
    assert(contains(cbuf, "complete -c") == 1, "fish: still a working completion");

    # A legitimate name must survive verbatim — the fix must not mangle the
    # ordinary case it exists to protect.
    var gh2 = cmdit_new("cmdit-smoke");
    cmdit_verb(gh2, "run", "run a thing");
    cn = capture_completions(gh2, "fish", cbuf, 8192);
    assert(cn > 0, "fish completion for an ordinary name captured");
    assert(contains(cbuf, "complete -c cmdit-smoke") == 1, "a hyphenated prog name is emitted verbatim");
    return 0;
}

# 1.3.2 a 0 handle (cmdit_new's OOM result) is safe on every public entry point
fn g086_1_3_2_0(): i64 {
    test_group("1.3.2 a 0 handle (cmdit_new's OOM result) is safe on every public entry point");
    # 1.2.4 claimed this and only the getters/modifiers honoured it. Each call below
    # dereferenced address 0 before 1.3.2. The handle is 0 only when alloc refused,
    # so the parse family fails closed and reports NOMEM.
    var zav = alloc(2 * 8); store64(zav, "t"); store64(zav + 8, "x");
    assert(cmdit_bool(0, 0, "a", "") == 0 - 1, "bool(0) -> -1");
    assert(cmdit_int(0, 0, "a", 0, "") == 0 - 1, "int(0) -> -1");
    assert(cmdit_str(0, 0, "a", 0, "") == 0 - 1, "str(0) -> -1");
    assert(cmdit_enum(0, 0, "a", 0, "x|y", "") == 0 - 1, "enum(0) -> -1");
    assert(cmdit_repeat(0, 0, "a", "") == 0 - 1, "repeat(0) -> -1");
    assert(cmdit_verb(0, "go", "") == 0 - 1, "verb(0) -> -1");
    assert(cmdit_verb_alias(0, 0, "g") == 0 - 1, "verb_alias(0) -> -1");
    assert(cmdit_parse_argv(0, 2, zav) == CMDIT_RESULT_ERR, "parse_argv(0) -> RESULT_ERR");
    assert(cmdit_dispatch_argv(0, 2, zav) == CMDIT_RESULT_ERR, "dispatch_argv(0) -> RESULT_ERR");
    assert(cmdit_parse(0) == CMDIT_RESULT_ERR, "parse(0) -> RESULT_ERR");
    assert(cmdit_dispatch(0) == CMDIT_RESULT_ERR, "dispatch(0) -> RESULT_ERR");
    assert(cmdit_finalize(0) == CMDIT_RESULT_ERR, "finalize(0) -> RESULT_ERR");
    assert(cmdit_argv(0) == 0, "argv(0) -> 0");
    assert(cmdit_parse_verb(0, 0) == CMDIT_RESULT_ERR, "parse_verb(0, 0) -> RESULT_ERR");
    var zvh = cmdit_new("t v");
    assert(cmdit_parse_verb(zvh, 0) == CMDIT_RESULT_ERR, "parse_verb(vh, 0) -> RESULT_ERR");
    assert(cmdit_error(zvh) == CMDIT_ERR_NOMEM, "... and the child reports NOMEM");
    assert(cmdit_require_positionals(0, 1) == CMDIT_RESULT_ERR, "require_positionals(0)");
    assert(cmdit_require_positionals_max(0, 1) == CMDIT_RESULT_ERR, "require_positionals_max(0)");
    assert(cmdit_require_positionals_exact(0, 1) == CMDIT_RESULT_ERR, "require_positionals_exact(0)");
    assert(cmdit_error(0) == CMDIT_ERR_NOMEM, "error(0) -> NOMEM");
    assert(cmdit_err_flag(0) == 0 - 1, "err_flag(0) -> -1");
    assert(cmdit_positional_count(0) == 0, "positional_count(0) -> 0");
    assert(cmdit_positional(0, 0) == 0, "positional(0) -> 0");
    assert(cmdit_verb_matched(0) == 0 - 1, "verb_matched(0) -> -1");
    assert(cmdit_verb_argc(0) == 0, "verb_argc(0) -> 0");
    assert(cmdit_verb_argv(0) == 0, "verb_argv(0) -> 0");
    assert(cmdit_raw_argv(0) == 0, "raw_argv(0) -> 0");
    assert(cmdit_raw_argc(0) == 0, "raw_argc(0) -> 0");
    assert(cmdit_help_flags(0) == 0, "help_flags(0) prints nothing");
    assert(cmdit_help(0) == 0, "help(0) prints nothing");
    assert(cmdit_verbs_help(0) == 0, "verbs_help(0) prints nothing");
    var zbuf = alloc(256);
    capture_print_error(0, zbuf, 256);
    assert(cstreq(zbuf, "out of memory\n") == 1, "print_error(0) says `out of memory`");
    return 0;
}

# 1.3.2 dispatch reports NOMEM when its remainder alloc is refused
fn g087_1_3_2_dispatch(): i64 {
    test_group("1.3.2 dispatch reports NOMEM when its remainder alloc is refused");
    # Before 1.3.2 this path returned RESULT_ERR with cmdit_error still NONE.
    var dnh = cmdit_new("t");
    cmdit_verb(dnh, "go", "");
    var dnav = alloc(2 * 8); store64(dnav, "t"); store64(dnav + 8, "go");
    # 2^28: (argc + 1) * 8 is a valid size just past stdlib ALLOC_MAX (2 GiB), so
    # alloc refuses it and the remainder pointer comes back 0.
    assert(cmdit_dispatch_argv(dnh, 268435456, dnav) == CMDIT_RESULT_ERR,
      "a remainder alloc that alloc refuses fails the dispatch");
    assert(cmdit_error(dnh) == CMDIT_ERR_NOMEM, "-> NOMEM, not ERR_NONE");
    assert(cmdit_err_flag(dnh) == 0 - 1, "names no flag");
    # 2^61: (argc + 1) * 8 wraps to 8, a buffer alloc grants. Before 1.3.2 the loop
    # then wrote the remainder past it.
    var dnh2 = cmdit_new("t");
    cmdit_verb(dnh2, "go", "");
    assert(cmdit_dispatch_argv(dnh2, 2305843009213693952, dnav) == CMDIT_RESULT_ERR,
      "an argc whose size wraps to a small buffer is refused");
    assert(cmdit_error(dnh2) == CMDIT_ERR_NOMEM, "-> NOMEM before any write");
    assert(_cmdit_grow(dnav, 0, 2305843009213693953) == 0, "_cmdit_grow refuses a cap whose size wraps to 16");
    assert(_cmdit_grow(dnav, 4, 2) == 0, "_cmdit_grow refuses a cap below the copy count");
    # The positional path at the same wrap: cap 2^61 + 1 doubles to a size that wraps to 16.
    var pwh = cmdit_new("t");
    store64(pwh + 32, 2305843009213693953);
    store64(pwh + 40, 2305843009213693953);
    assert(cmdit_parse_argv(pwh, 2, dnav) == CMDIT_RESULT_ERR, "positional growth at a wrapping size is refused");
    assert(cmdit_error(pwh) == CMDIT_ERR_NOMEM, "-> NOMEM, not a 16-byte array");
    return 0;
}

# 1.3.2 zsh and fish completions apply the 1.2.1 name whitelist
fn g088_1_3_2_zsh(): i64 {
    test_group("1.3.2 zsh and fish completions apply the 1.2.1 name whitelist");
    var wh = cmdit_new("tool");
    cmdit_verb(wh, "add", "add a thing");
    cmdit_verb(wh, "x(touch /tmp/cmdit_fish)", "hostile name");
    cmdit_verb(wh, "a:b", "colon splits zsh's name:desc");
    var wbuf = alloc(16384);
    capture_completions(wh, "fish", wbuf, 16384);
    assert(contains(wbuf, "-a 'add'") == 1, "fish keeps a safe verb");
    assert(contains(wbuf, "touch") == 0, "fish drops a name carrying (cmd)");
    assert(contains(wbuf, "a:b") == 0, "fish drops a name outside the whitelist");
    capture_completions(wh, "zsh", wbuf, 16384);
    assert(contains(wbuf, "'add:add a thing'") == 1, "zsh keeps a safe verb");
    assert(contains(wbuf, "touch") == 0, "zsh drops a name carrying (cmd)");
    assert(contains(wbuf, "a:b") == 0, "zsh drops a name with a colon");
    capture_completions(wh, "bash", wbuf, 16384);
    assert(contains(wbuf, "touch") == 0, "bash still drops it (1.2.1)");
    return 0;
}

# 1.3.2 verb aliases must name a registered verb
fn g089_1_3_2_verb(): i64 {
    test_group("1.3.2 verb aliases must name a registered verb");
    var ah = cmdit_new("t");
    var av0 = cmdit_verb(ah, "remove", "");
    assert(cmdit_verb_alias(ah, av0, "rm") == av0, "alias of a real verb OK");
    assert(cmdit_verb_alias(ah, 5, "zz") == 0 - 1, "alias of a missing verb -> -1");
    assert(cmdit_verb_alias(ah, 1, "r") == 0 - 1, "alias of an alias row -> -1");
    assert(cmdit_verb_count(ah) == 2, "rejected aliases add no rows");
    return 0;
}

# 1.3.2 _cmdit_repeat_cap terminates past 2^62
fn g090_1_3_2_cmdit(): i64 {
    test_group("1.3.2 _cmdit_repeat_cap terminates past 2^62");
    # A count above 2^62 used to double the cap into a negative, then 0, forever.
    var bigc = 4611686018427387905;
    assert(_cmdit_repeat_cap(bigc) >= bigc, "returns a cap that covers the count");
    var rch = cmdit_new("t");
    var rcf = cmdit_repeat(rch, 72, "header", "");
    var rcav = alloc(3 * 8); store64(rcav, "t"); store64(rcav + 8, "-H"); store64(rcav + 16, "a");
    assert(cmdit_parse_argv(rch, 3, rcav) == CMDIT_OK, "first -H allocates the list");
    store64(_cmdit_entry(rch, rcf) + 96, bigc);
    assert(cmdit_parse_argv(rch, 3, rcav) == CMDIT_RESULT_ERR, "a push at that count fails");
    assert(cmdit_error(rch) == CMDIT_ERR_NOMEM, "-> NOMEM, and it terminates");
    store64(rcav + 16, "b");
    cmdit_parse_argv(rch, 3, rcav);
    assert(cstreq(cmdit_get_str(rch, rcf), "a") == 1, "a refused push leaves the last-wins view alone");
    return 0;
}

# 1.3.2 a trailing-marked verb counts only positionals, not its own flags
fn g091_1_3_2_trailing(): i64 {
    test_group("1.3.2 a trailing-marked verb counts only positionals, not its own flags");
    # `exec --tty --root /x c1 ls`: --tty is a verb flag, --root a global. Before
    # 1.3.2 --tty counted as exec's one positional, so --root fell into the payload.
    var th1 = cmdit_new("t");
    var tg1 = cmdit_str(th1, 0, "root", "/default", "");
    var tv1 = cmdit_verb(th1, "exec", "");
    cmdit_verb_trailing_after(th1, tv1, 1);
    var tav1 = alloc(7 * 8);
    store64(tav1, "t"); store64(tav1 + 8, "exec"); store64(tav1 + 16, "--tty");
    store64(tav1 + 24, "--root"); store64(tav1 + 32, "/x"); store64(tav1 + 40, "c1"); store64(tav1 + 48, "ls");
    assert(cmdit_dispatch_argv(th1, 7, tav1) == CMDIT_OK, "dispatch OK");
    assert(cstreq(cmdit_get_str(th1, tg1), "/x") == 1, "the global after a verb flag is applied");
    var tc1 = cmdit_new("t exec");
    cmdit_bool(tc1, 0, "tty", "");
    assert(cmdit_parse_verb(tc1, th1) == CMDIT_OK, "the verb scope parses --tty c1 ls");
    assert(cmdit_positional_count(tc1) == 2, "payload is c1 ls");
    # The payload is still never parsed for globals.
    var th1b = cmdit_new("t");
    var tg1b = cmdit_str(th1b, 0, "root", "/default", "");
    var tv1b = cmdit_verb(th1b, "exec", "");
    cmdit_verb_trailing_after(th1b, tv1b, 1);
    store64(tav1 + 16, "c1"); store64(tav1 + 24, "mycmd"); store64(tav1 + 32, "--root"); store64(tav1 + 40, "/y");
    assert(cmdit_dispatch_argv(th1b, 6, tav1) == CMDIT_OK, "dispatch OK (payload has --root)");
    assert(cstreq(cmdit_get_str(th1b, tg1b), "/default") == 1, "a global inside the payload is still not applied");
    return 0;
}

# 1.3.2 `tool add --help` is not blocked by a required global
fn g092_1_3_2_tool(): i64 {
    test_group("1.3.2 `tool add --help` is not blocked by a required global");
    var th2 = cmdit_new("t");
    var tr2 = cmdit_str(th2, 0, "handle", 0, "");
    cmdit_required(th2, tr2);
    cmdit_verb(th2, "add", "");
    var tav2 = alloc(3 * 8); store64(tav2, "t"); store64(tav2 + 8, "add"); store64(tav2 + 16, "--help");
    assert(cmdit_dispatch_argv(th2, 3, tav2) == CMDIT_OK, "dispatch defers --help to the verb");
    assert(cmdit_finalize(th2) == CMDIT_OK, "finalize does not demand --handle when help was asked for");
    var tc2 = cmdit_new("t add");
    assert(cmdit_parse_verb(tc2, th2) == CMDIT_HELP, "the verb scope returns HELP");
    var th2b = cmdit_new("t");
    var tr2b = cmdit_str(th2b, 0, "handle", 0, "");
    cmdit_required(th2b, tr2b);
    cmdit_verb(th2b, "add", "");
    store64(tav2 + 16, "x");
    assert(cmdit_dispatch_argv(th2b, 3, tav2) == CMDIT_OK, "an ordinary dispatch");
    assert(cmdit_finalize(th2b) == CMDIT_RESULT_ERR, "still demands --handle without --help");
    return 0;
}

# 1.3.2 a `--` right at a trailing-verbatim threshold is consumed
fn g093_1_3_2_right(): i64 {
    test_group("1.3.2 a `--` right at a trailing-verbatim threshold is consumed");
    # `exec c1 -- ls -l` (the 1.2.2 escape hatch) ran the command `--` once exec
    # was marked. A `--` at the threshold is now consumed, kubectl-style.
    var th3 = cmdit_new("t");
    var tv3 = cmdit_verb(th3, "exec", "");
    cmdit_verb_trailing_after(th3, tv3, 1);
    var tav3 = alloc(6 * 8);
    store64(tav3, "t"); store64(tav3 + 8, "exec"); store64(tav3 + 16, "c1");
    store64(tav3 + 24, "--"); store64(tav3 + 32, "ls"); store64(tav3 + 40, "-l");
    assert(cmdit_dispatch_argv(th3, 6, tav3) == CMDIT_OK, "dispatch OK");
    var tc3 = cmdit_new("t exec");
    assert(cmdit_parse_verb(tc3, th3) == CMDIT_OK, "verb parse OK");
    assert(cmdit_positional_count(tc3) == 3, "payload is c1 ls -l, without the --");
    assert(cstreq(cmdit_positional(tc3, 1), "ls") == 1, "the command is ls");
    var th3b = cmdit_new("t");
    var tv3b = cmdit_verb(th3b, "exec", "");
    cmdit_verb_trailing_after(th3b, tv3b, 1);
    store64(tav3 + 32, "--");                      # t exec c1 -- -- -l
    assert(cmdit_dispatch_argv(th3b, 6, tav3) == CMDIT_OK, "dispatch OK (double --)");
    var tc3b = cmdit_new("t exec");
    cmdit_parse_verb(tc3b, th3b);
    assert(cstreq(cmdit_positional(tc3b, 1), "--") == 1, "only the first -- is consumed");
    return 0;
}

# 1.3.2 a bundled short before the verb is BUNDLED, as in the parse core
fn g094_1_3_2_bundled(): i64 {
    test_group("1.3.2 a bundled short before the verb is BUNDLED, as in the parse core");
    var th4 = cmdit_new("t");
    cmdit_bool(th4, 118, "verbose", "");
    cmdit_verb(th4, "add", "");
    var tav4 = alloc(3 * 8); store64(tav4, "t"); store64(tav4 + 8, "-vx"); store64(tav4 + 16, "add");
    assert(cmdit_dispatch_argv(th4, 3, tav4) == CMDIT_RESULT_ERR, "-vx before the verb fails");
    assert(cmdit_error(th4) == CMDIT_ERR_BUNDLED, "-> BUNDLED, not UNKNOWN");
    return 0;
}

# 1.3.2 trailing marks resolve through an alias row
fn g095_1_3_2_trailing(): i64 {
    test_group("1.3.2 trailing marks resolve through an alias row");
    var th5 = cmdit_new("t");
    var tv5 = cmdit_verb(th5, "exec", "");
    var ta5 = cmdit_verb_alias(th5, tv5, "x");
    assert(ta5 == tv5, "alias returns the canonical id");
    assert(cmdit_verb_trailing_after(th5, 1, 1) == tv5, "marking the alias row marks the verb");
    assert(cmdit_verb_trailing_at(th5, tv5) == 1, "the canonical verb carries the mark");
    assert(cmdit_verb_trailing_at(th5, 1) == 1, "and reading it through the alias row agrees");
    return 0;
}

# 1.3.2 the argv bridge fails closed when argv cannot be read whole
fn g096_1_3_2_argv(): i64 {
    test_group("1.3.2 the argv bridge fails closed when argv cannot be read whole");
    # n <= 0: no argv[0], i.e. /proc/self/cmdline was unreadable. len == 2 MiB: a
    # pre-6.7.12 stdlib args_init's single read filled its buffer and may have cut the
    # tail (1.4.2 narrowed this from >=; see g114). Both used to parse as a short (or
    # empty) argv and return CMDIT_OK.
    assert(_cmdit_argv_whole(0, 0) == 0, "no arguments at all -> not whole");
    assert(_cmdit_argv_whole(0 - 1, 0) == 0, "a negative count -> not whole");
    assert(_cmdit_argv_whole(3, 100) == 1, "an ordinary command line is whole");
    assert(_cmdit_argv_whole(3, 2097151) == 1, "one byte under the read buffer is whole");
    assert(_cmdit_argv_whole(3, 2097152) == 0, "a full 2 MiB read may be cut -> not whole");
    var ah1 = cmdit_new("t");
    var ah2 = cmdit_new("t");
    assert(cmdit_argv(ah1) >= 1, "the test process argv materializes");
    cmdit_argv(ah2);
    assert(cmdit_raw_argv(ah1) == cmdit_raw_argv(ah2), "materialized once per process, shared by handles");
    var aeh = cmdit_new("t");
    store64(aeh + 56, CMDIT_ERR_ARGV);
    var aebuf = alloc(256);
    capture_print_error(aeh, aebuf, 256);
    assert(cstreq(aebuf, "t: could not read the full command line\n") == 1, "ARGV renders its message");
    return 0;
}

# 1.3.2 the public CMDIT_*_MAX vars no longer steer storage
fn g097_1_3_2_public(): i64 {
    test_group("1.3.2 the public CMDIT_*_MAX vars no longer steer storage");
    # Each was read live: raising one after a table was allocated overflowed the heap,
    # and CMDIT_REPEAT_MAX = 0 hung the next repeat push.
    var sv_flags = CMDIT_FLAGS_MAX;
    var sv_verbs = CMDIT_VERB_MAX;
    var sv_rep = CMDIT_REPEAT_MAX;
    var sv_ent = CMDIT_ENTRY_SIZE;
    var mh = cmdit_new("t");
    CMDIT_FLAGS_MAX = 200;
    var mk = 2;
    var mlast = 0;
    while (mk < 70) { mlast = cmdit_bool(mh, 0, "f", ""); mk = mk + 1; }
    assert(mlast == 0 - 1, "registration still stops at the handle's 64");
    assert(cmdit_get_bool(mh, 63) == 0, "flag 63 is readable");
    CMDIT_REPEAT_MAX = 0;
    var mrh = cmdit_new("t");
    var mrf = cmdit_repeat(mrh, 72, "header", "");
    var mrav = alloc(5 * 8);
    store64(mrav, "t"); store64(mrav + 8, "-H"); store64(mrav + 16, "a");
    store64(mrav + 24, "-H"); store64(mrav + 32, "b");
    assert(cmdit_parse_argv(mrh, 5, mrav) == CMDIT_OK, "repeat pushes with CMDIT_REPEAT_MAX = 0 (it hung)");
    assert(cmdit_repeat_count(mrh, mrf) == 2, "both kept");
    CMDIT_VERB_MAX = 300;
    var mvh = cmdit_new("t");
    var mvk = 0;
    var mvlast = 0;
    while (mvk < 130) { mvlast = cmdit_verb(mvh, "v", ""); mvk = mvk + 1; }
    assert(mvlast == 0 - 1, "verb registration still stops at the handle's 128");
    CMDIT_ENTRY_SIZE = 8;
    assert(cmdit_get_bool(mh, 2) == 0, "entry stride does not follow CMDIT_ENTRY_SIZE");
    CMDIT_FLAGS_MAX = sv_flags;
    CMDIT_VERB_MAX = sv_verbs;
    CMDIT_REPEAT_MAX = sv_rep;
    CMDIT_ENTRY_SIZE = sv_ent;
    return 0;
}

# 1.3.2 SECURITY: a program name starting with '-' is not read as options (with the 2 groups after
# it, which share its fixtures)
fn g098_1_3_2_security(): i64 {
    test_group("1.3.2 SECURITY: a program name starting with '-' is not read as options");
    # argv[0] = "-DCtrue" emitted `complete -F __DCtrue_complete -DCtrue`; sourcing it
    # bundled to `-D -C true` and replaced the user's default completion with a PATH
    # command run at every TAB. The leading '-' is mapped to '_' in all three shells.
    var dsh = cmdit_new("-DCtrue");
    cmdit_verb(dsh, "run", "");
    var dsbuf = alloc(16384);
    capture_completions(dsh, "bash", dsbuf, 16384);
    assert(contains(dsbuf, "_complete _DCtrue\n") == 1, "bash registers the mapped name");
    assert(contains(dsbuf, " -DCtrue") == 0, "no -DCtrue reaches `complete`");
    capture_completions(dsh, "fish", dsbuf, 16384);
    assert(contains(dsbuf, "complete -c _DCtrue") == 1, "fish -c gets the mapped name");
    assert(contains(dsbuf, "-c -DCtrue") == 0, "fish never sees -DCtrue");
    capture_completions(dsh, "zsh", dsbuf, 16384);
    assert(contains(dsbuf, "#compdef _DCtrue") == 1, "zsh #compdef gets the mapped name");
    var dsh2 = cmdit_new("tool-x");
    cmdit_verb(dsh2, "run", "");
    capture_completions(dsh2, "bash", dsbuf, 16384);
    assert(contains(dsbuf, "_complete tool-x\n") == 1, "an internal '-' is kept");

    test_group("1.3.2 an empty program name falls back to `prog` in completions");
    var emh = cmdit_new("");
    cmdit_verb(emh, "run", "");
    capture_completions(emh, "bash", dsbuf, 16384);
    assert(contains(dsbuf, "complete -F _prog_complete prog\n") == 1, "empty name -> prog");

    test_group("1.3.2 completions skip the value of a SHORT value flag too");
    # `tool -j 5 <TAB>` took 5 for the verb: only `--long` spellings were in the skip set.
    var svh = cmdit_new("tool");
    cmdit_str(svh, 114, "root", 0, "");
    cmdit_int(svh, 106, 0, 1, "");
    cmdit_bool(svh, 118, "verbose", "");
    cmdit_verb(svh, "add", "");
    capture_completions(svh, "bash", dsbuf, 16384);
    assert(contains(dsbuf, "local valueflags='--root -r -j'") == 1, "bash skip set has --root -r -j");
    capture_completions(svh, "zsh", dsbuf, 16384);
    assert(contains(dsbuf, "valueflags=( --root -r -j )") == 1, "zsh skip set has --root -r -j");
    return 0;
}

# 1.3.3 cmdit_err_token / cmdit_err_value name what the user typed (with the 1 group after it,
# which share its fixtures)
fn g099_1_3_3_cmdit(): i64 {
    test_group("1.3.3 cmdit_err_token / cmdit_err_value name what the user typed");
    # Seven tools echoed this by re-scanning argv. The token is an interior pointer
    # into argv (no copy); the value too, inside the token when attached.
    var eb = alloc(512);
    var eh1 = cmdit_new("prog");
    cmdit_bool(eh1, 118, "loud", "");
    var eav = alloc(4 * 8);
    store64(eav, "prog"); store64(eav + 8, "--bogus=1");
    assert(cmdit_parse_argv(eh1, 2, eav) == CMDIT_RESULT_ERR, "unknown long flag fails");
    assert(cmdit_err_token(eh1) == load64(eav + 8), "UNKNOWN: token is the argv entry itself");
    assert(cmdit_err_value(eh1) == 0, "UNKNOWN: no value");
    capture_print_error(eh1, eb, 512);
    assert(cstreq(eb, "prog: unknown flag: --bogus=1\n") == 1, "renders `unknown flag: --bogus=1`");
    var eh2 = cmdit_new("prog");
    cmdit_bool(eh2, 118, "loud", "");
    store64(eav + 8, "-vx");
    assert(cmdit_parse_argv(eh2, 2, eav) == CMDIT_RESULT_ERR, "bundled short fails");
    assert(cmdit_err_token(eh2) == load64(eav + 8), "BUNDLED: token is -vx");
    capture_print_error(eh2, eb, 512);
    assert(cstreq(eb, "prog: -vx: bundled/attached short flags not supported (use -x -y)\n") == 1,
      "renders `-vx: bundled/...`");
    var eh3 = cmdit_new("prog");
    var ec3 = cmdit_int(eh3, 99, "count", 1, "");
    cmdit_range(eh3, ec3, 1, 10);
    store64(eav + 8, "--count"); store64(eav + 16, "abc");
    assert(cmdit_parse_argv(eh3, 3, eav) == CMDIT_RESULT_ERR, "bad int fails");
    assert(cmdit_err_token(eh3) == load64(eav + 8), "BAD_INT: token is the flag as typed");
    assert(cmdit_err_value(eh3) == load64(eav + 16), "BAD_INT: value is the separate argv entry");
    capture_print_error(eh3, eb, 512);
    assert(cstreq(eb, "prog: --count: invalid integer value 'abc'\n") == 1, "renders the rejected value, quoted");
    var eh4 = cmdit_new("prog");
    var ec4 = cmdit_int(eh4, 99, "count", 1, "");
    cmdit_range(eh4, ec4, 1, 10);
    var eatt = "--count=99";
    store64(eav + 8, eatt);
    assert(cmdit_parse_argv(eh4, 2, eav) == CMDIT_RESULT_ERR, "out of range fails");
    assert(cmdit_err_token(eh4) == eatt, "OUT_OF_RANGE: token is the attached form");
    assert(cmdit_err_value(eh4) == eatt + 8, "OUT_OF_RANGE: value points inside the token");
    capture_print_error(eh4, eb, 512);
    assert(cstreq(eb, "prog: --count: value '99' out of range\n") == 1, "renders `value '99' out of range`");
    var eh5 = cmdit_new("prog");
    cmdit_enum(eh5, 0, "color", "auto", "auto|always|never", "");
    store64(eav + 8, "--color"); store64(eav + 16, "purple");
    assert(cmdit_parse_argv(eh5, 3, eav) == CMDIT_RESULT_ERR, "bad enum fails");
    assert(cstreq(cmdit_err_value(eh5), "purple") == 1, "BAD_ENUM: value");
    capture_print_error(eh5, eb, 512);
    assert(cstreq(eb, "prog: --color: invalid value 'purple' (expected auto|always|never)\n") == 1,
      "renders the value and the choice set");
    var eh6 = cmdit_new("prog");
    cmdit_str(eh6, 110, "name", 0, "");
    store64(eav + 8, "-n");
    assert(cmdit_parse_argv(eh6, 2, eav) == CMDIT_RESULT_ERR, "missing value fails");
    assert(cmdit_err_token(eh6) == load64(eav + 8), "MISSING_VALUE: token is the flag");
    assert(cmdit_err_value(eh6) == 0, "MISSING_VALUE: no value");
    capture_print_error(eh6, eb, 512);
    assert(cstreq(eb, "prog: --name: missing value\n") == 1, "MISSING_VALUE line is unchanged");
    var eh6b = cmdit_new("prog");
    cmdit_str(eh6b, 110, "name", 0, "");
    store64(eav + 8, "--name");
    assert(cmdit_parse_argv(eh6b, 2, eav) == CMDIT_RESULT_ERR, "long missing value fails");
    assert(cmdit_err_token(eh6b) == load64(eav + 8), "MISSING_VALUE (long): token is --name");
    var eh7 = cmdit_new("prog");
    var er7 = cmdit_str(eh7, 0, "handle", 0, "");
    cmdit_required(eh7, er7);
    assert(cmdit_parse_argv(eh7, 1, eav) == CMDIT_OK, "an empty parse");
    assert(cmdit_finalize(eh7) == CMDIT_RESULT_ERR, "required missing");
    assert(cmdit_err_token(eh7) == 0 && cmdit_err_value(eh7) == 0, "REQUIRED_MISSING: no token, no value");
    var eh8 = cmdit_new("prog");
    store64(eav + 8, "a"); store64(eav + 16, "b"); store64(eav + 24, "c");
    assert(cmdit_parse_argv(eh8, 4, eav) == CMDIT_OK, "three positionals");
    assert(cmdit_require_positionals_max(eh8, 1) == CMDIT_RESULT_ERR, "max 1 fails");
    assert(cmdit_err_token(eh8) == load64(eav + 16), "TOO_MANY: token is the first extra positional");
    capture_print_error(eh8, eb, 512);
    assert(cstreq(eb, "prog: too many arguments: b\n") == 1, "renders `too many arguments: b`");
    assert(cmdit_require_positionals_exact(eh8, 2) == CMDIT_RESULT_ERR, "exact 2 fails");
    assert(cmdit_err_token(eh8) == load64(eav + 24), "exact: the first extra is c");
    assert(cmdit_require_positionals(eh8, 5) == CMDIT_RESULT_ERR, "min 5 fails");
    assert(cmdit_err_token(eh8) == 0, "MISSING_POSITIONAL: no token");
    # The dispatcher: a global before and after the verb, and an unknown verb.
    var ed = cmdit_new("prog");
    cmdit_int(ed, 106, "jobs", 1, "");
    cmdit_verb(ed, "go", "");
    store64(eav + 8, "--jobs"); store64(eav + 16, "x"); store64(eav + 24, "go");
    assert(cmdit_dispatch_argv(ed, 4, eav) == CMDIT_RESULT_ERR, "global bad int before the verb");
    assert(cmdit_err_token(ed) == load64(eav + 8), "dispatch: token is the global flag");
    assert(cmdit_err_value(ed) == load64(eav + 16), "dispatch: value is x");
    var ed2 = cmdit_new("prog");
    cmdit_int(ed2, 106, "jobs", 1, "");
    cmdit_verb(ed2, "go", "");
    var edatt = "--jobs=y";
    store64(eav + 8, "go"); store64(eav + 16, edatt);
    assert(cmdit_dispatch_argv(ed2, 3, eav) == CMDIT_RESULT_ERR, "global bad int after the verb");
    assert(cmdit_err_value(ed2) == edatt + 7, "after the verb: value inside the attached token");
    var ed3 = cmdit_new("prog");
    cmdit_verb(ed3, "go", "");
    store64(eav + 8, "bogus");
    assert(cmdit_dispatch_argv(ed3, 2, eav) == CMDIT_RESULT_ERR, "unknown verb");
    assert(cmdit_err_token(ed3) == load64(eav + 8), "UNKNOWN_VERB: token (the 0.3.0 slot, now public)");
    var ed4 = cmdit_new("prog");
    cmdit_verb(ed4, "go", "");
    store64(eav + 8, "--nope"); store64(eav + 16, "go");
    assert(cmdit_dispatch_argv(ed4, 3, eav) == CMDIT_RESULT_ERR, "unknown global before the verb");
    assert(cmdit_err_token(ed4) == load64(eav + 8), "dispatch UNKNOWN: token is --nope");
    store64(eav + 8, "go"); store64(eav + 16, "x");
    assert(cmdit_dispatch_argv(ed4, 3, eav) == CMDIT_OK, "a clean dispatch on the same handle");
    assert(cmdit_err_token(ed4) == 0, "no token leaks across dispatches");
    # A clean parse on a handle whose last parse failed leaves no token behind.
    var er = cmdit_new("prog");
    cmdit_bool(er, 118, "loud", "");
    store64(eav + 8, "--nope");
    cmdit_parse_argv(er, 2, eav);
    assert(cmdit_err_token(er) != 0, "first parse records a token");
    store64(eav + 8, "--loud");
    assert(cmdit_parse_argv(er, 2, eav) == CMDIT_OK, "second parse is clean");
    assert(cmdit_err_token(er) == 0 && cmdit_err_value(er) == 0, "no token or value leaks across parses");
    # A positional the array could not store is the token (as in stdlib).
    var epn = cmdit_new("prog");
    store64(epn + 32, 2305843009213693953);
    store64(epn + 40, 2305843009213693953);
    store64(eav + 8, "x");
    assert(cmdit_parse_argv(epn, 2, eav) == CMDIT_RESULT_ERR, "positional growth refused");
    assert(cmdit_err_token(epn) == load64(eav + 8), "NOMEM: token is the positional");
    assert(cmdit_err_token(0) == 0 && cmdit_err_value(0) == 0, "a 0 handle has neither");

    test_group("1.3.3 argv-derived text is escaped in errors, help and version");
    # ESC in a token would otherwise put terminal sequences into the user's stderr.
    var esct = alloc(16);                          # "--b" ESC "[31m" + UTF-8 "é"
    store8(esct, 45); store8(esct + 1, 45); store8(esct + 2, 98); store8(esct + 3, 27);
    store8(esct + 4, 91); store8(esct + 5, 51); store8(esct + 6, 49); store8(esct + 7, 109);
    store8(esct + 8, 195); store8(esct + 9, 169); store8(esct + 10, 0);
    var exh = cmdit_new("prog");
    store64(eav + 8, esct);
    assert(cmdit_parse_argv(exh, 2, eav) == CMDIT_RESULT_ERR, "a hostile unknown flag");
    capture_print_error(exh, eb, 512);
    var eexp = alloc(64);                          # "prog: unknown flag: --b?[31m" "é" "\n"
    var ek = 0;
    var epfx = "prog: unknown flag: --b?[31m";
    while (load8(epfx + ek) != 0) { store8(eexp + ek, load8(epfx + ek)); ek = ek + 1; }
    store8(eexp + ek, 195); store8(eexp + ek + 1, 169); store8(eexp + ek + 2, 10); store8(eexp + ek + 3, 0);
    assert(cstreq(eb, eexp) == 1, "ESC becomes ?, UTF-8 passes through");
    var exv = alloc(8);                            # value "a" DEL "b"
    store8(exv, 97); store8(exv + 1, 127); store8(exv + 2, 98); store8(exv + 3, 0);
    var exh2 = cmdit_new("prog");
    cmdit_int(exh2, 99, "count", 1, "");
    store64(eav + 8, "-c"); store64(eav + 16, exv);
    cmdit_parse_argv(exh2, 3, eav);
    capture_print_error(exh2, eb, 512);
    assert(cstreq(eb, "prog: --count: invalid integer value 'a?b'\n") == 1, "DEL in a value becomes ?");
    var exn = alloc(8);                            # program name "t" BEL
    store8(exn, 116); store8(exn + 1, 7); store8(exn + 2, 0);
    var exh3 = cmdit_new(exn);
    store64(eav + 8, "--nope");
    cmdit_parse_argv(exh3, 2, eav);
    capture_print_error(exh3, eb, 512);
    assert(cstreq(eb, "t?: unknown flag: --nope\n") == 1, "argv[0] is escaped in the error line");
    capture_help(exh3, eb, 512);
    assert(contains(eb, "Usage: t? [options]") == 1, "and in help");
    capture_version(exh3, "1.0", eb, 512);
    assert(cstreq(eb, "t? 1.0\n") == 1, "and in --version");
    return 0;
}

# 1.3.4 cmdit_stop_at_positional: POSIX stop at the first positional
fn g100_1_3_4_cmdit(): i64 {
    test_group("1.3.4 cmdit_stop_at_positional: POSIX stop at the first positional");
    # shakti's grammar: its flags, then a command line that is entirely the child's.
    var sp = cmdit_new("shakti");
    var spu = cmdit_str(sp, 117, "user", "root", "");
    var spk = cmdit_bool(sp, 107, "invalidate", "");
    assert(cmdit_stop_at_positional(sp, 1) == 0, "setter returns 0");
    var spav = alloc(8 * 8);
    store64(spav, "shakti"); store64(spav + 8, "-u"); store64(spav + 16, "alice"); store64(spav + 24, "-k");
    store64(spav + 32, "/bin/cmd"); store64(spav + 40, "arg1"); store64(spav + 48, "-x"); store64(spav + 56, "arg2");
    assert(cmdit_parse_argv(sp, 8, spav) == CMDIT_OK, "flags, then a command with its own flags");
    assert(cstreq(cmdit_get_str(sp, spu), "alice") == 1, "-u alice applied (its value is not the boundary)");
    assert(cmdit_get_bool(sp, spk) == 1, "-k applied");
    assert(cmdit_positional_count(sp) == 4, "the command line is 4 positionals");
    assert(cmdit_positional(sp, 2) == load64(spav + 48), "-x after the command is data (shakti cli.tcyr:160)");
    # `ls -1 | xargs rm --`: a `--` after the boundary belongs to the child.
    var sx = cmdit_new("xargs");
    cmdit_stop_at_positional(sx, 1);
    var sxav = alloc(3 * 8); store64(sxav, "xargs"); store64(sxav + 8, "rm"); store64(sxav + 16, "--");
    assert(cmdit_parse_argv(sx, 3, sxav) == CMDIT_OK, "xargs rm --");
    assert(cmdit_positional_count(sx) == 2, "the -- is kept (kriya: eating it let rm delete a directory)");
    assert(cmdit_positional(sx, 1) == load64(sxav + 16), "and passed through as data");
    # A `--` BEFORE the boundary still ends the options, and is consumed.
    var sd = cmdit_new("t");
    cmdit_stop_at_positional(sd, 1);
    var sdav = alloc(4 * 8);
    store64(sdav, "t"); store64(sdav + 8, "--"); store64(sdav + 16, "-weird"); store64(sdav + 24, "x");
    assert(cmdit_parse_argv(sd, 4, sdav) == CMDIT_OK, "-- -weird x");
    assert(cmdit_positional_count(sd) == 2, "the leading -- is consumed");
    assert(cmdit_positional(sd, 0) == load64(sdav + 16), "-weird is the first positional");
    # A lone `-` is an operand (POSIX), so it stops option recognition too.
    var sl = cmdit_new("t");
    cmdit_bool(sl, 120, "x", "");
    cmdit_stop_at_positional(sl, 1);
    store64(sdav + 8, "-"); store64(sdav + 16, "-x");
    assert(cmdit_parse_argv(sl, 3, sdav) == CMDIT_OK, "- -x");
    assert(cmdit_positional_count(sl) == 2, "- and -x are both positionals");
    assert(cmdit_get_bool(sl, 2) == 0, "-x after the - is not applied");
    # Before the boundary the usual rules hold: an unknown flag is still an error.
    var su = cmdit_new("t");
    cmdit_stop_at_positional(su, 1);
    store64(sdav + 8, "-z"); store64(sdav + 16, "cmd");
    assert(cmdit_parse_argv(su, 3, sdav) == CMDIT_RESULT_ERR, "-z before the command fails");
    assert(cmdit_error(su) == CMDIT_ERR_UNKNOWN, "-> UNKNOWN (xargs -5 echo: GNU says invalid option)");
    # A bundled-looking token after the boundary is data, not BUNDLED.
    var sb = cmdit_new("t");
    cmdit_stop_at_positional(sb, 1);
    store64(sdav + 8, "ls"); store64(sdav + 16, "-la");
    assert(cmdit_parse_argv(sb, 3, sdav) == CMDIT_OK, "ls -la");
    assert(cmdit_positional(sb, 1) == load64(sdav + 16), "-la is data");
    # --help after the boundary is data; before it, help.
    var sh1 = cmdit_new("t");
    cmdit_stop_at_positional(sh1, 1);
    store64(sdav + 8, "cmd"); store64(sdav + 16, "--help");
    assert(cmdit_parse_argv(sh1, 3, sdav) == CMDIT_OK, "cmd --help is not help");
    assert(cmdit_positional_count(sh1) == 2, "--help is the command's argument");
    var sh2 = cmdit_new("t");
    cmdit_stop_at_positional(sh2, 1);
    store64(sdav + 8, "--help"); store64(sdav + 16, "cmd");
    assert(cmdit_parse_argv(sh2, 3, sdav) == CMDIT_HELP, "--help cmd is help");
    # Off by default, and the setter turns it back off.
    var so = cmdit_new("t");
    store64(sdav + 8, "cmd"); store64(sdav + 16, "-x");
    assert(cmdit_parse_argv(so, 3, sdav) == CMDIT_RESULT_ERR, "default: -x after a positional is still a flag");
    var so2 = cmdit_new("t");
    cmdit_stop_at_positional(so2, 7);
    cmdit_stop_at_positional(so2, 0);
    assert(cmdit_parse_argv(so2, 3, sdav) == CMDIT_RESULT_ERR, "on (any non-zero), then off again");
    assert(cmdit_stop_at_positional(0, 1) == 0 - 1, "a 0 handle -> -1");
    var so3 = cmdit_new("t");
    cmdit_stop_at_positional(so3, 7);
    assert(cmdit_parse_argv(so3, 3, sdav) == CMDIT_OK, "any non-zero `on` enables the mode");
    return 0;
}

# 1.3.4 stop-at-positional on a verb handle: globals only before the verb
fn g101_1_3_4_stop(): i64 {
    test_group("1.3.4 stop-at-positional on a verb handle: globals only before the verb");
    var sv = cmdit_new("t");
    var svj = cmdit_int(sv, 106, "jobs", 1, "");
    cmdit_verb(sv, "run", "");
    var svav = alloc(7 * 8);
    store64(svav, "t"); store64(svav + 8, "--jobs"); store64(svav + 16, "2"); store64(svav + 24, "run");
    store64(svav + 32, "--jobs"); store64(svav + 40, "5"); store64(svav + 48, "x");
    var sv0 = cmdit_new("t");
    var sv0j = cmdit_int(sv0, 106, "jobs", 1, "");
    cmdit_verb(sv0, "run", "");
    assert(cmdit_dispatch_argv(sv0, 7, svav) == CMDIT_OK, "default dispatch");
    assert(cmdit_get_int(sv0, sv0j) == 5, "default: the global after the verb wins (before OR after)");
    cmdit_stop_at_positional(sv, 1);
    assert(cmdit_dispatch_argv(sv, 7, svav) == CMDIT_OK, "stop-mode dispatch");
    assert(cmdit_get_int(sv, svj) == 2, "stop mode: only the global before the verb applies");
    assert(cmdit_verb_argc(sv) == 4, "the after-verb --jobs 5 x go to the verb: run --jobs 5 x");
    assert(load64(cmdit_verb_argv(sv) + 8) == load64(svav + 32), "--jobs is in the remainder");
    # `tool add --help` still hands help to the verb, past a required global.
    var svhh = cmdit_new("t");
    var svr = cmdit_str(svhh, 0, "handle", 0, "");
    cmdit_required(svhh, svr);
    cmdit_verb(svhh, "add", "");
    cmdit_stop_at_positional(svhh, 1);
    store64(svav + 8, "add"); store64(svav + 16, "--help");
    assert(cmdit_dispatch_argv(svhh, 3, svav) == CMDIT_OK, "add --help under stop mode");
    assert(cmdit_finalize(svhh) == CMDIT_OK, "the required check is still skipped for help");
    return 0;
}

# 1.3.5 the verb list's content is pinned (with the 2 groups after it, which share its fixtures)
fn g102_1_3_5_verb(): i64 {
    test_group("1.3.5 the verb list's content is pinned");
    # The listing was only ever checked for its return code. (1.3.5 caught itself
    # reading a hidden flag one row too far, which no existing test noticed.)
    var vlh = cmdit_new("tool");
    cmdit_bool(vlh, 118, "verbose", "be verbose");
    cmdit_verb(vlh, "add", "add a thing");
    var vlr = cmdit_verb(vlh, "remove", "remove a thing");
    cmdit_verb_alias(vlh, vlr, "rm");
    cmdit_verb(vlh, "run", 0);
    var vlb = alloc(4096);
    var vlb2 = alloc(4096);
    capture_render(vlh, 5, 2, vlb, 4096);
    assert(cstreq(vlb, "\nCommands:\n  add\tadd a thing\n  remove\tremove a thing\n  run\n") == 1,
      "verbs_help lists real verbs in order, aliases skipped");

    test_group("1.3.5 help renderers take a stream; the stderr forms are unchanged");
    capture_render(vlh, 3, 2, vlb, 4096);
    capture_render(vlh, 0, 1, vlb2, 4096);
    assert(contains(vlb, "Usage: tool [options] [args]") == 1, "help on stderr");
    assert(cstreq(vlb, vlb2) == 1, "help_fd(h, 1) on stdout is byte-identical to help on stderr");
    capture_render(vlh, 4, 2, vlb, 4096);
    capture_render(vlh, 1, 1, vlb2, 4096);
    assert(contains(vlb, "-v, --verbose\tbe verbose") == 1, "flag rows on stderr");
    assert(cstreq(vlb, vlb2) == 1, "help_flags_fd(h, 1) matches help_flags");
    capture_render(vlh, 5, 2, vlb, 4096);
    capture_render(vlh, 2, 1, vlb2, 4096);
    assert(cstreq(vlb, vlb2) == 1, "verbs_help_fd(h, 1) matches verbs_help");
    capture_render(vlh, 0, 2, vlb2, 4096);
    capture_render(vlh, 3, 2, vlb, 4096);
    assert(cstreq(vlb, vlb2) == 1, "help_fd(h, 2) is exactly help(h)");
    assert(cmdit_help_fd(0, 1) == 0 && cmdit_help_flags_fd(0, 1) == 0 && cmdit_verbs_help_fd(0, 1) == 0,
      "the fd forms tolerate a 0 handle");

    test_group("1.3.5 hidden verbs dispatch but stay out of help and completions");
    var hvh = cmdit_new("tool");
    cmdit_verb(hvh, "add", "add a thing");
    var hvd = cmdit_verb(hvh, "debug", "internal");
    cmdit_verb_alias(hvh, hvd, "dbg");
    cmdit_verb(hvh, "run", "run it");
    assert(cmdit_verb_hidden(hvh, hvd) == hvd, "hide returns the verb id");
    assert(cmdit_verb_is_hidden(hvh, hvd) == 1, "the verb row reads hidden");
    assert(cmdit_verb_is_hidden(hvh, 2) == 1, "its alias row reads hidden too");
    assert(cmdit_verb_is_hidden(hvh, 0) == 0, "a visible verb reads visible");
    capture_render(hvh, 5, 2, vlb, 4096);
    assert(cstreq(vlb, "\nCommands:\n  add\tadd a thing\n  run\trun it\n") == 1, "verbs_help skips the hidden verb");
    capture_render(hvh, 3, 2, vlb, 4096);
    assert(contains(vlb, "debug") == 0, "help skips it");
    var hvav = alloc(2 * 8); store64(hvav, "tool"); store64(hvav + 8, "debug");
    assert(cmdit_dispatch_argv(hvh, 2, hvav) == CMDIT_OK, "a hidden verb still dispatches");
    assert(cmdit_verb_matched(hvh) == hvd, "to its own id");
    var hvh2 = cmdit_new("tool");
    var hvd2 = cmdit_verb(hvh2, "debug", "");
    cmdit_verb_alias(hvh2, hvd2, "dbg");
    cmdit_verb_hidden(hvh2, hvd2);
    store64(hvav + 8, "dbg");
    assert(cmdit_dispatch_argv(hvh2, 2, hvav) == CMDIT_OK, "so does its alias");
    assert(cmdit_verb_matched(hvh2) == hvd2, "to the hidden verb");
    var hvh3 = cmdit_new("tool");
    cmdit_verb(hvh3, "add", "");
    var hvd3 = cmdit_verb(hvh3, "debug", "");
    cmdit_verb_hidden(hvh3, hvd3);
    store64(hvav + 8, "nope");
    cmdit_dispatch_argv(hvh3, 2, hvav);
    capture_print_error(hvh3, vlb, 4096);
    assert(contains(vlb, "unknown command: nope") == 1, "an unknown verb still errors");
    assert(contains(vlb, "  add") == 1, "and lists the visible verbs");
    assert(contains(vlb, "debug") == 0, "but not the hidden one");
    capture_completions(hvh, "bash", vlb, 4096);
    assert(contains(vlb, "local verbs='add run'") == 1, "bash completes neither debug nor dbg");
    capture_completions(hvh, "zsh", vlb, 4096);
    assert(contains(vlb, "debug") == 0, "zsh skips it");
    capture_completions(hvh, "fish", vlb, 4096);
    assert(contains(vlb, "debug") == 0 && contains(vlb, "-a 'add'") == 1, "fish skips it");
    # Hiding through an alias row hides the verb; the trailing mark still applies.
    var hvh4 = cmdit_new("tool");
    var hvd4 = cmdit_verb(hvh4, "exec", "");
    cmdit_verb_alias(hvh4, hvd4, "x");
    assert(cmdit_verb_hidden(hvh4, 1) == hvd4, "hiding the alias row hides the verb");
    assert(cmdit_verb_is_hidden(hvh4, hvd4) == 1, "the verb reads hidden");
    assert(cmdit_verb_trailing_after(hvh4, hvd4, 1) == hvd4, "a hidden verb can still be marked");
    assert(cmdit_verb_hidden(hvh4, 9) == 0 - 1, "an id past the table -> -1");
    assert(cmdit_verb_hidden(hvh4, 0 - 1) == 0 - 1, "a negative id -> -1");
    assert(cmdit_verb_hidden(0, 0) == 0 - 1, "a 0 handle -> -1");
    assert(cmdit_verb_hidden(cmdit_new("t"), 0) == 0 - 1, "no verb table -> -1");
    assert(cmdit_verb_is_hidden(hvh4, 9) == 0, "is_hidden past the table -> 0");
    # Every verb hidden: help prints no Commands header at all.
    var hvh5 = cmdit_new("tool");
    cmdit_verb_hidden(hvh5, cmdit_verb(hvh5, "debug", ""));
    capture_render(hvh5, 3, 2, vlb, 4096);
    assert(contains(vlb, "Commands:") == 0, "no empty Commands: block");
    return 0;
}

# 1.3.6 cmdit_once: a second occurrence is CMDIT_ERR_REPEATED
fn g103_1_3_6_cmdit(): i64 {
    test_group("1.3.6 cmdit_once: a second occurrence is CMDIT_ERR_REPEATED");
    var ob = alloc(512);
    var oh = cmdit_new("prog");
    var oc = cmdit_int(oh, 99, "context", 0, "");
    assert(cmdit_once(oh, oc) == oc, "cmdit_once returns idx");
    var oav = alloc(5 * 8);
    store64(oav, "prog"); store64(oav + 8, "--context=1"); store64(oav + 16, "--context=2");
    assert(cmdit_parse_argv(oh, 3, oav) == CMDIT_RESULT_ERR, "--context=1 --context=2 fails (cyim case 41)");
    assert(cmdit_error(oh) == CMDIT_ERR_REPEATED, "-> REPEATED");
    assert(cmdit_err_flag(oh) == oc, "names --context");
    assert(cmdit_err_token(oh) == load64(oav + 16), "the token is the second occurrence");
    assert(cmdit_err_value(oh) == 0, "REPEATED rejects no value");
    capture_print_error(oh, ob, 512);
    assert(cstreq(ob, "prog: --context: may be given only once\n") == 1, "renders `may be given only once`");
    var oh2 = cmdit_new("prog");
    var oc2 = cmdit_int(oh2, 99, "context", 0, "");
    cmdit_once(oh2, oc2);
    store64(oav + 8, "-c"); store64(oav + 16, "1"); store64(oav + 24, "--context"); store64(oav + 32, "2");
    assert(cmdit_parse_argv(oh2, 5, oav) == CMDIT_RESULT_ERR, "short then long spelling is still twice");
    var oh3 = cmdit_new("prog");
    var ow3 = cmdit_bool(oh3, 0, "wc", "");
    cmdit_once(oh3, ow3);
    store64(oav + 8, "--wc"); store64(oav + 16, "--wc");
    assert(cmdit_parse_argv(oh3, 3, oav) == CMDIT_RESULT_ERR, "a bool given twice (cyim case 30)");
    var oh4 = cmdit_new("prog");
    var oc4 = cmdit_int(oh4, 99, "context", 0, "");
    cmdit_once(oh4, oc4);
    store64(oav + 8, "--context=3");
    assert(cmdit_parse_argv(oh4, 2, oav) == CMDIT_OK, "once is fine");
    assert(cmdit_get_int(oh4, oc4) == 3, "and applied");
    var oh5 = cmdit_new("prog");
    var oc5 = cmdit_int(oh5, 99, "context", 0, "");
    store64(oav + 8, "--context=1"); store64(oav + 16, "--context=2");
    assert(cmdit_parse_argv(oh5, 3, oav) == CMDIT_OK, "without cmdit_once, last wins (unchanged)");
    assert(cmdit_get_int(oh5, oc5) == 2, "the second value");
    var oh6 = cmdit_new("prog");
    var or6 = cmdit_repeat(oh6, 72, "header", "");
    cmdit_once(oh6, or6);
    store64(oav + 8, "-H"); store64(oav + 16, "a"); store64(oav + 24, "-H"); store64(oav + 32, "b");
    assert(cmdit_parse_argv(oh6, 5, oav) == CMDIT_RESULT_ERR, "once on a repeat flag caps it at one");
    var od = cmdit_new("prog");
    var odj = cmdit_int(od, 106, "jobs", 1, "");
    cmdit_once(od, odj);
    cmdit_verb(od, "go", "");
    store64(oav + 8, "--jobs=1"); store64(oav + 16, "go"); store64(oav + 24, "--jobs=2");
    assert(cmdit_dispatch_argv(od, 4, oav) == CMDIT_RESULT_ERR, "a global once before and after the verb");
    assert(cmdit_error(od) == CMDIT_ERR_REPEATED, "-> REPEATED from the dispatcher");
    if (getenv("HOME") != 0) {
        var oe = cmdit_new("prog");
        var oes = cmdit_str(oe, 0, "home", 0, "");
        cmdit_once(oe, oes);
        cmdit_env(oe, oes, "HOME");
        store64(oav + 8, "--home=/x");
        assert(cmdit_parse_argv(oe, 2, oav) == CMDIT_OK, "given once on the command line");
        assert(cmdit_finalize(oe) == CMDIT_OK, "the env fallback is not a second occurrence");
        var oe2 = cmdit_new("prog");
        var oes2 = cmdit_str(oe2, 0, "home", 0, "");
        cmdit_once(oe2, oes2);
        cmdit_env(oe2, oes2, "HOME");
        assert(cmdit_parse_argv(oe2, 1, oav) == CMDIT_OK, "absent on the command line");
        assert(cmdit_finalize(oe2) == CMDIT_OK, "the env fallback applies once");
        assert(cmdit_get_str(oe2, oes2) != 0, "from HOME");
    }
    assert(cmdit_once(0, 0) == 0 - 1 && cmdit_once(oh, 99) == 0 - 1, "bad handle / idx -> -1");
    return 0;
}

# 1.3.6 cmdit_enum_nocase: ASCII case-insensitive choices
fn g104_1_3_6_cmdit(): i64 {
    test_group("1.3.6 cmdit_enum_nocase: ASCII case-insensitive choices");
    var nch = cmdit_new("prog");
    var ns = cmdit_enum(nch, 0, "severity", "Medium", "critical|high|medium|low", "");
    assert(cmdit_enum_nocase(nch, ns) == ns, "cmdit_enum_nocase returns idx");
    assert(cmdit_get_enum(nch, ns) == 2, "the default `Medium` resolves to medium");
    var ncav = alloc(3 * 8); store64(ncav, "prog"); store64(ncav + 8, "--severity"); store64(ncav + 16, "HiGh");
    assert(cmdit_parse_argv(nch, 3, ncav) == CMDIT_OK, "HiGh is accepted (phylax --severity-threshold)");
    assert(cmdit_get_enum(nch, ns) == 1, "the index of high");
    assert(cmdit_get_str(nch, ns) == load64(ncav + 16), "get_str keeps the text as typed");
    var nh2 = cmdit_new("prog");
    var ns2 = cmdit_enum(nh2, 0, "severity", 0, "critical|high|medium|low", "");
    assert(cmdit_parse_argv(nh2, 3, ncav) == CMDIT_RESULT_ERR, "without the modifier, case still matters");
    assert(cmdit_error(nh2) == CMDIT_ERR_BAD_ENUM, "-> BAD_ENUM (unchanged)");
    var nh3 = cmdit_new("prog");
    var ns3 = cmdit_enum(nh3, 0, "severity", 0, "critical|high|medium|low", "");
    cmdit_enum_nocase(nh3, ns3);
    store64(ncav + 16, "HUGE");
    assert(cmdit_parse_argv(nh3, 3, ncav) == CMDIT_RESULT_ERR, "a non-choice is still refused");
    assert(cmdit_err_value(nh3) == load64(ncav + 16), "with its value");
    store64(ncav + 16, "HIG");
    var nh4 = cmdit_new("prog");
    cmdit_enum_nocase(nh4, cmdit_enum(nh4, 0, "severity", 0, "critical|high|medium|low", ""));
    assert(cmdit_parse_argv(nh4, 3, ncav) == CMDIT_RESULT_ERR, "a prefix is still not a match");
    var nh5 = cmdit_new("prog");
    var nn5 = cmdit_int(nh5, 0, "count", 1, "");
    assert(cmdit_enum_nocase(nh5, nn5) == nn5, "a no-op on a non-enum flag");
    return 0;
}

# 1.3.6 cmdit_long_alias: a second long name
fn g105_1_3_6_cmdit(): i64 {
    test_group("1.3.6 cmdit_long_alias: a second long name");
    var lah = cmdit_new("ark");
    var lam = cmdit_bool(lah, 0, "marketplace", "marketplace packages");
    var las = cmdit_str(lah, 115, "source", 0, "where from");
    assert(cmdit_long_alias(lah, lam, "market") == lam, "cmdit_long_alias returns idx");
    cmdit_long_alias(lah, las, "src");
    var laav = alloc(4 * 8);
    store64(laav, "ark"); store64(laav + 8, "--market"); store64(laav + 16, "--src=apt");
    assert(cmdit_parse_argv(lah, 3, laav) == CMDIT_OK, "--market and --src=apt parse");
    assert(cmdit_get_bool(lah, lam) == 1, "--market sets marketplace");
    assert(cstreq(cmdit_get_str(lah, las), "apt") == 1, "--src=apt sets source");
    var lah2 = cmdit_new("ark");
    var lam2 = cmdit_bool(lah2, 0, "marketplace", "");
    cmdit_long_alias(lah2, lam2, "market");
    store64(laav + 8, "--marketplace");
    assert(cmdit_parse_argv(lah2, 2, laav) == CMDIT_OK, "the first name still works");
    var lah3 = cmdit_new("ark");
    cmdit_long_alias(lah3, cmdit_bool(lah3, 0, "marketplace", ""), "market");
    store64(laav + 8, "--mark");
    assert(cmdit_parse_argv(lah3, 2, laav) == CMDIT_RESULT_ERR, "a prefix of the alias is not a match");
    var lad = cmdit_new("ark");
    var ladv = cmdit_bool(lad, 0, "verbose", "");
    cmdit_long_alias(lad, ladv, "loud");
    cmdit_verb(lad, "list", "");
    store64(laav + 8, "list"); store64(laav + 16, "--loud");
    assert(cmdit_dispatch_argv(lad, 3, laav) == CMDIT_OK, "the alias works as a global after the verb");
    assert(cmdit_get_bool(lad, ladv) == 1, "and sets the flag");
    var lab = alloc(4096);
    capture_render(lah, 4, 2, lab, 4096);
    assert(contains(lab, "      --marketplace, --market\tmarketplace packages\n") == 1, "help shows both long names");
    assert(contains(lab, "  -s, --source, --src <str>\twhere from\n") == 1, "with a short letter too");
    var lah4 = cmdit_new("ark");
    var las4 = cmdit_str(lah4, 0, "source", 0, "");
    cmdit_long_alias(lah4, las4, "src");
    cmdit_verb(lah4, "list", "");
    capture_completions(lah4, "bash", lab, 4096);
    assert(contains(lab, "local flags='--help --version --source --src'") == 1, "bash offers both names");
    assert(contains(lab, "local valueflags='--source --src'") == 1, "and skips the value after either");
    assert(cmdit_long_alias(lah, lam, 0) == 0 - 1, "a null name -> -1");
    assert(cmdit_long_alias(lah, lam, "") == 0 - 1, "an empty name -> -1");
    assert(cmdit_long_alias(0, 0, "x") == 0 - 1 && cmdit_long_alias(lah, 99, "x") == 0 - 1,
      "bad handle / idx -> -1");
    return 0;
}

# 1.3.6 cmdit_reject_flag_value: a flag is not a value (hapi F-019)
fn g106_1_3_6_cmdit(): i64 {
    test_group("1.3.6 cmdit_reject_flag_value: a flag is not a value (hapi F-019)");
    var rfh = cmdit_new("hapi");
    var rr = cmdit_str(rfh, 114, "root", 0, "");
    cmdit_bool(rfh, 0, "dry-run", "");
    assert(cmdit_reject_flag_value(rfh, rr) == rr, "cmdit_reject_flag_value returns idx");
    var rfav = alloc(4 * 8);
    store64(rfav, "hapi"); store64(rfav + 8, "--root"); store64(rfav + 16, "--dry-run"); store64(rfav + 24, "pkg");
    assert(cmdit_parse_argv(rfh, 4, rfav) == CMDIT_RESULT_ERR, "--root --dry-run pkg fails");
    assert(cmdit_error(rfh) == CMDIT_ERR_MISSING_VALUE, "-> MISSING_VALUE, not root = --dry-run");
    assert(cmdit_err_flag(rfh) == rr, "naming --root");
    var rh2 = cmdit_new("hapi");
    var rr2 = cmdit_str(rh2, 114, "root", 0, "");
    cmdit_bool(rh2, 0, "dry-run", "");
    assert(cmdit_parse_argv(rh2, 4, rfav) == CMDIT_OK, "without the modifier, getopt takes it (unchanged)");
    assert(cstreq(cmdit_get_str(rh2, rr2), "--dry-run") == 1, "root = --dry-run");
    var rh3 = cmdit_new("hapi");
    var rr3 = cmdit_str(rh3, 114, "root", 0, "");
    cmdit_reject_flag_value(rh3, rr3);
    store64(rfav + 16, "-");
    assert(cmdit_parse_argv(rh3, 3, rfav) == CMDIT_OK, "a lone - is still a value");
    var rh4 = cmdit_new("hapi");
    var rr4 = cmdit_str(rh4, 114, "root", 0, "");
    cmdit_reject_flag_value(rh4, rr4);
    store64(rfav + 8, "--root=--dry-run");
    assert(cmdit_parse_argv(rh4, 2, rfav) == CMDIT_OK, "an attached value is taken as written");
    assert(cstreq(cmdit_get_str(rh4, rr4), "--dry-run") == 1, "root = --dry-run on purpose");
    var rh5 = cmdit_new("t");
    var ro5 = cmdit_int(rh5, 0, "offset", 0, "");
    cmdit_reject_flag_value(rh5, ro5);
    store64(rfav + 8, "--offset"); store64(rfav + 16, "-5");
    assert(cmdit_parse_argv(rh5, 3, rfav) == CMDIT_OK, "an int flag still takes -5");
    assert(cmdit_get_int(rh5, ro5) == 0 - 5, "offset = -5");
    var rh6 = cmdit_new("t");
    cmdit_reject_flag_value(rh6, cmdit_int(rh6, 0, "offset", 0, ""));
    store64(rfav + 16, "-x");
    assert(cmdit_parse_argv(rh6, 3, rfav) == CMDIT_RESULT_ERR, "but not -x");
    var rh7 = cmdit_new("hapi");
    cmdit_reject_flag_value(rh7, cmdit_str(rh7, 114, "root", 0, ""));
    store64(rfav + 8, "-r"); store64(rfav + 16, "--x");
    assert(cmdit_parse_argv(rh7, 3, rfav) == CMDIT_RESULT_ERR, "the short form is guarded too");
    var rh8 = cmdit_new("t");
    cmdit_reject_flag_value(rh8, cmdit_repeat(rh8, 72, "header", ""));
    store64(rfav + 8, "-H"); store64(rfav + 16, "--x");
    assert(cmdit_parse_argv(rh8, 3, rfav) == CMDIT_RESULT_ERR, "and a repeat flag");
    var rd = cmdit_new("hapi");
    cmdit_reject_flag_value(rd, cmdit_str(rd, 0, "root", 0, ""));
    cmdit_bool(rd, 0, "dry-run", "");
    cmdit_verb(rd, "link", "");
    store64(rfav + 8, "--root"); store64(rfav + 16, "--dry-run"); store64(rfav + 24, "link");
    assert(cmdit_dispatch_argv(rd, 4, rfav) == CMDIT_RESULT_ERR, "a global before the verb");
    assert(cmdit_error(rd) == CMDIT_ERR_MISSING_VALUE, "-> MISSING_VALUE from the dispatcher");
    assert(cmdit_reject_flag_value(0, 0) == 0 - 1 && cmdit_reject_flag_value(rfh, 99) == 0 - 1,
      "bad handle / idx -> -1");
    return 0;
}

# ══ 1.3.7: flag-table introspection + per-verb flags in completions ══════════
# 1.3.7 flag-table introspection: what was registered (with the 1 group after it, which share its
# fixtures)
fn g107_1_3_7_flag(): i64 {
    test_group("1.3.7 flag-table introspection: what was registered");
    var fqh = cmdit_new("kriya");
    assert(cmdit_flag_count(fqh) == 2, "a new handle holds the auto --help and --version");
    assert(cstreq(cmdit_flag_long_at(fqh, 0), "help") == 1 && cstreq(cmdit_flag_long_at(fqh, 1), "version") == 1,
      "as rows 0 and 1");
    assert(cmdit_flag_short_at(fqh, 0) == 104 && cmdit_flag_short_at(fqh, 1) == 86, "-h and -V");
    var fqn = cmdit_int(fqh, 110, "lines", 10, "line count");
    var fqc = cmdit_enum(fqh, 0, "color", "auto", "auto|always|never", "when to color");
    var fqo = cmdit_str(fqh, 111, "output", "out.txt", "output file");
    cmdit_metavar(fqh, fqo, "FILE");
    cmdit_long_alias(fqh, fqo, "out");
    cmdit_required(fqh, fqo);
    var fqr = cmdit_repeat(fqh, 72, "header", "a header");
    var fqb = cmdit_bool(fqh, 113, "quiet", 0);
    assert(cmdit_flag_count(fqh) == 7, "the count follows registration");
    assert(cmdit_flag_type_at(fqh, fqn) == CMDIT_INT, "type: int");
    assert(cmdit_flag_type_at(fqh, fqb) == CMDIT_BOOL, "type: bool");
    assert(cmdit_flag_type_at(fqh, fqc) == CMDIT_STR && cmdit_flag_type_at(fqh, fqr) == CMDIT_STR,
      "an enum and a repeat flag are CMDIT_STR");
    assert(cmdit_flag_short_at(fqh, fqo) == 111, "short letter");
    assert(cmdit_flag_short_at(fqh, fqc) == 0, "no short letter -> 0");
    assert(cstreq(cmdit_flag_long_at(fqh, fqo), "output") == 1, "long name");
    assert(cstreq(cmdit_flag_long_alias_at(fqh, fqo), "out") == 1, "second long name");
    assert(cmdit_flag_long_alias_at(fqh, fqn) == 0, "no second long name -> 0");
    assert(cstreq(cmdit_flag_help_at(fqh, fqn), "line count") == 1, "help");
    assert(cmdit_flag_help_at(fqh, fqb) == 0, "no help -> 0");
    assert(cmdit_flag_default_at(fqh, fqn) == 10, "an int default");
    assert(cstreq(cmdit_flag_default_at(fqh, fqo), "out.txt") == 1, "a cstr default");
    assert(cmdit_flag_default_at(fqh, fqb) == 0, "a bool's default is 0");
    assert(cstreq(cmdit_flag_choices_at(fqh, fqc), "auto|always|never") == 1, "an enum's choices");
    assert(cmdit_flag_choices_at(fqh, fqo) == 0, "not an enum -> 0");
    assert(cstreq(cmdit_flag_metavar_at(fqh, fqo), "FILE") == 1, "metavar");
    assert(cmdit_flag_metavar_at(fqh, fqn) == 0, "no metavar -> 0");
    assert(cmdit_flag_is_required(fqh, fqo) == 1 && cmdit_flag_is_required(fqh, fqn) == 0, "required: 1 / 0");
    assert(cmdit_flag_is_repeat(fqh, fqr) == 1 && cmdit_flag_is_repeat(fqh, fqo) == 0, "repeat: 1 / 0");
    var fqv = alloc(64);
    store64(fqv, "kriya"); store64(fqv + 8, "--lines"); store64(fqv + 16, "3"); store64(fqv + 24, "--out=x");
    assert(cmdit_parse_argv(fqh, 4, fqv) == CMDIT_OK, "parse");
    assert(cmdit_get_int(fqh, fqn) == 3 && cmdit_flag_default_at(fqh, fqn) == 10,
      "after parse the default is still the registered one");
    var fqids = alloc(24);
    store64(fqids, 0 - 1); store64(fqids + 8, 7); store64(fqids + 16, 1099511627776);
    var fqk = 0;
    while (fqk < 3) {
        var fqx = load64(fqids + fqk * 8);
        assert(cmdit_flag_short_at(fqh, fqx) == 0 && cmdit_flag_long_at(fqh, fqx) == 0
          && cmdit_flag_long_alias_at(fqh, fqx) == 0 && cmdit_flag_help_at(fqh, fqx) == 0
          && cmdit_flag_default_at(fqh, fqx) == 0 && cmdit_flag_choices_at(fqh, fqx) == 0
          && cmdit_flag_metavar_at(fqh, fqx) == 0 && cmdit_flag_is_required(fqh, fqx) == 0
          && cmdit_flag_is_repeat(fqh, fqx) == 0, "a bad index -> 0 from every accessor");
        assert(cmdit_flag_type_at(fqh, fqx) == 0 - 1, "and -1 from the type");
        fqk = fqk + 1;
    }
    assert(cmdit_flag_count(0) == 0 && cmdit_flag_long_at(0, 0) == 0 && cmdit_flag_type_at(0, 0) == 0 - 1,
      "a 0 handle");

    test_group("1.3.7 flag lookup: the parser's own -x / --name resolution");
    assert(cmdit_flag_find_short(fqh, 111) == fqo, "-o");
    assert(cmdit_flag_find_short(fqh, 104) == 0, "-h is the auto help row");
    assert(cmdit_flag_find_short(fqh, 122) == 0 - 1, "an unregistered letter -> -1");
    assert(cmdit_flag_find_short(fqh, 0) == 0 - 1, "letter 0 -> -1, not the first flag that has none");
    assert(cmdit_flag_find_short(0, 111) == 0 - 1, "a 0 handle -> -1");
    assert(cmdit_flag_type_at(fqh, cmdit_flag_find_short(fqh, 110)) == CMDIT_INT,
      "kriya's expander asks whether -n takes a value");
    assert(cmdit_flag_type_at(fqh, cmdit_flag_find_short(fqh, 122)) == 0 - 1, "and an unknown letter answers -1");
    assert(cmdit_flag_find_long(fqh, "output", 6) == fqo, "--output");
    assert(cmdit_flag_find_long(fqh, "out", 3) == fqo, "the second long name finds the same flag");
    assert(cmdit_flag_find_long(fqh, "output=x.txt", 6) == fqo, "the span of --output=x.txt up to the '='");
    assert(cmdit_seen(fqh, cmdit_flag_find_long(fqh, "out", 3)) == 1, "the flag the parse set from --out=x");
    assert(cmdit_flag_find_long(fqh, "outp", 4) == 0 - 1, "a prefix is not a match");
    assert(cmdit_flag_find_long(fqh, "outputs", 7) == 0 - 1, "a longer name is not a match");
    assert(cmdit_flag_find_long(fqh, "help", 4) == 0, "--help is row 0");
    assert(cmdit_flag_find_long(fqh, "nope", 4) == 0 - 1, "an unknown name -> -1");
    assert(cmdit_flag_find_long(fqh, "output", 0 - 1) == 0 - 1, "a negative length -> -1");
    assert(cmdit_flag_find_long(fqh, 0, 6) == 0 - 1, "a null name -> -1");
    assert(cmdit_flag_find_long(0, "output", 6) == 0 - 1, "a 0 handle -> -1");
    var fqnb = alloc(16);                        # "ab\0cd\0": a name with bytes past its NUL
    store8(fqnb, 97); store8(fqnb + 1, 98); store8(fqnb + 2, 0);
    store8(fqnb + 3, 99); store8(fqnb + 4, 100); store8(fqnb + 5, 0);
    var fqnh = cmdit_new("t");
    var fqnf = cmdit_bool(fqnh, 0, fqnb, "");
    assert(cmdit_flag_find_long(fqnh, fqnb, 2) == fqnf, "the span \"ab\" finds the flag named ab");
    assert(cmdit_flag_find_long(fqnh, fqnb, 5) == 0 - 1,
      "a span holding a NUL matches nothing, though the bytes past the name's NUL agree");
    return 0;
}

# 1.3.7 cmdit_verb_flags: a verb's own flag handle
fn g108_1_3_7_cmdit(): i64 {
    test_group("1.3.7 cmdit_verb_flags: a verb's own flag handle");
    var vfa = cmdit_new("ark");
    var vfai = cmdit_new("ark install");
    assert(cmdit_verb_flags(vfa, 0, vfai) == 0 - 1, "no verb registered yet -> -1");
    var vfi = cmdit_verb(vfa, "install", "Install");
    var vfr = cmdit_verb(vfa, "remove", "Remove");
    cmdit_verb_alias(vfa, vfr, "uninstall");
    assert(cmdit_verb_flags_at(vfa, vfi) == 0, "nothing attached -> 0");
    assert(cmdit_verb_flags(vfa, vfi, vfai) == vfi, "attach returns the verb's id");
    assert(cmdit_verb_flags_at(vfa, vfi) == vfai, "and reads back");
    var vfar = cmdit_new("ark remove");
    assert(cmdit_verb_flags(vfa, 2, vfar) == vfr, "attaching on the alias row lands on its verb");
    assert(cmdit_verb_flags_at(vfa, vfr) == vfar && cmdit_verb_flags_at(vfa, 2) == vfar,
      "both rows read the verb's handle");
    assert(cmdit_verb_flags(vfa, 3, vfai) == 0 - 1 && cmdit_verb_flags(vfa, 0 - 1, vfai) == 0 - 1
      && cmdit_verb_flags(0, 0, vfai) == 0 - 1, "a bad id or handle -> -1");
    assert(cmdit_verb_flags_at(vfa, 3) == 0 && cmdit_verb_flags_at(vfa, 0 - 1) == 0
      && cmdit_verb_flags_at(0, 0) == 0, "a bad row -> 0");
    assert(cmdit_verb_flags(vfa, vfi, 0) == vfi && cmdit_verb_flags_at(vfa, vfi) == 0, "0 detaches");
    var vfpg = cmdit_bool(vfar, 0, "purge", "");
    var vfv = alloc(64);
    store64(vfv, "ark"); store64(vfv + 8, "uninstall"); store64(vfv + 16, "--purge"); store64(vfv + 24, "pkg");
    assert(cmdit_dispatch_argv(vfa, 4, vfv) == CMDIT_OK, "dispatch");
    var vfm = cmdit_verb_flags_at(vfa, cmdit_verb_matched(vfa));
    assert(vfm == vfar, "the matched verb's handle, found after dispatch");
    assert(cmdit_parse_argv(vfm, cmdit_verb_argc(vfa), cmdit_verb_argv(vfa)) == CMDIT_OK
      && cmdit_get_bool(vfm, vfpg) == 1, "parses the verb's remainder");
    return 0;
}

# 1.3.7 per-verb flags in completions (with the 2 groups after it, which share its fixtures)
fn g109_1_3_7_per(): i64 {
    test_group("1.3.7 per-verb flags in completions");
    var pvc = cmdit_new("ark");
    cmdit_bool(pvc, 0, "no-color", "");
    cmdit_str(pvc, 114, "root", 0, "");
    var pvci = cmdit_verb(pvc, "install", "Install");
    var pvcr = cmdit_verb(pvc, "remove", "Remove");
    cmdit_verb_alias(pvc, pvcr, "uninstall");
    cmdit_verb_alias(pvc, pvcr, "rm!");
    cmdit_verb(pvc, "info", "Info C:\\");
    var pvcb = cmdit_verb(pvc, "bench", "");
    cmdit_verb_hidden(pvc, pvcb);
    var pvcx = cmdit_verb(pvc, "x;y", "");
    var pvcih = cmdit_new("ark install");
    cmdit_bool(pvcih, 102, "force", "Force it");
    cmdit_str(pvcih, 103, "group", 0, "Install group");
    cmdit_bool(pvcih, 121, 0, "Assume yes");
    cmdit_verb_flags(pvc, pvci, pvcih);
    var pvcrh = cmdit_new("ark remove");
    var pvcp = cmdit_bool(pvcrh, 0, "purge", "Purge (it's gone) C:\\");
    cmdit_long_alias(pvcrh, pvcp, "wipe");
    cmdit_bool(pvcrh, 0, "a$(id)", "");
    cmdit_verb_flags(pvc, pvcr, pvcrh);
    var pvcbh = cmdit_new("ark bench");
    cmdit_bool(pvcbh, 0, "secret", "");
    cmdit_verb_flags(pvc, pvcb, pvcbh);
    var pvcxh = cmdit_new("x");
    cmdit_bool(pvcxh, 0, "zzz", "");
    cmdit_verb_flags(pvc, pvcx, pvcxh);
    var pvb = alloc(16384);
    capture_completions(pvc, "bash", pvb, 16384);
    assert(contains(pvb, "    local cur i w seen_verb=0 skip=0 verb=\n") == 1, "bash: declares $verb");
    assert(contains(pvb, "        seen_verb=1; verb=\"$w\"; break\n") == 1, "bash: the walk keeps the verb");
    assert(index_of(pvb, "    for (( i=1;") >= 0
      && index_of(pvb, "    for (( i=1;") < index_of(pvb, "    if [[ \"$cur\" == -* ]]; then\n"),
      "bash: the walk runs before the flag branch, which needs the verb");
    assert(contains(pvb, "        case \"$verb\" in\n            install) flags=\"$flags --force --group\" ;;\n") == 1,
      "bash: install's flags join the globals, without its own --help/--version");
    assert(contains(pvb, "            remove|uninstall) flags=\"$flags --purge --wipe\" ;;\n        esac\n") == 1,
      "bash: an alias selects the arm; the second long name is offered; unsafe names are dropped");
    assert(contains(pvb, "secret") == 0, "bash: a hidden verb's flags are not offered");
    assert(contains(pvb, "zzz") == 0, "bash: nor those of a verb whose name fails the whitelist");
    assert(contains(pvb, "    local flags='--help --version --no-color --root'\n") == 1,
      "bash: the global list is unchanged");
    capture_completions(pvc, "zsh", pvb, 16384);
    assert(contains(pvb, "    local i seen=0 skip=0 w verb\n") == 1, "zsh: declares verb");
    assert(contains(pvb, "        seen=1; verb=$w; break\n") == 1, "zsh: the walk keeps the verb");
    var pvk1 = cat2("    elif [[ $PREFIX == -* ]]; then\n        case $verb in\n",
      "            install) compadd -- --help --version --force --group ;;\n");
    assert(contains(pvb, pvk1) == 1,
      "zsh: install's whole flag list on a word starting with -");
    var pvk2 = cat2("            remove|uninstall) compadd -- --help --version --purge --wipe ;;\n",
      "            *) _files ;;\n        esac\n    else\n        _files\n");
    assert(contains(pvb, pvk2) == 1, "zsh: remove's arm, then files");
    assert(contains(pvb, "secret") == 0 && contains(pvb, "zzz") == 0, "zsh: hidden and unsafe verbs get no arm");
    capture_completions(pvc, "fish", pvb, 16384);
    assert(contains(pvb, "complete -c ark -n '__fish_seen_subcommand_from install' -s f -l force -d 'Force it'\n") == 1,
      "fish: a bool flag, short and long on one line");
    var pvk3 = cat2("complete -c ark -n '__fish_seen_subcommand_from install'",
      " -s g -l group -r -d 'Install group'\n");
    assert(contains(pvb, pvk3) == 1,
      "fish: a value flag carries -r");
    assert(contains(pvb, "complete -c ark -n '__fish_seen_subcommand_from install' -s y -d 'Assume yes'\n") == 1,
      "fish: a flag with only a short letter still gets its line");
    var pvk4 = cat2("complete -c ark -n '__fish_seen_subcommand_from install'",
      " -s h -l help -d 'show this help and exit'\n");
    assert(contains(pvb, pvk4) == 1,
      "fish: the verb's own --help, since fish completes no global flags");
    var pvk5 = cat2("complete -c ark -n '__fish_seen_subcommand_from remove uninstall'",
      " -l purge -d 'Purge (it'\\''s gone) C:\\\\'\n");
    assert(contains(pvb, pvk5) == 1,
      "fish: aliases select the line; an apostrophe and a trailing backslash stay quoted");
    var pvk6 = cat2("complete -c ark -n '__fish_seen_subcommand_from remove uninstall'",
      " -l wipe -d 'Purge (it'\\''s gone) C:\\\\'\n");
    assert(contains(pvb, pvk6) == 1,
      "fish: the second long name on its own line");
    assert(contains(pvb, "-a 'info' -d 'Info C:\\\\'\n") == 1,
      "fish: a verb's help ending in a backslash is escaped too");
    assert(contains(pvb, "secret") == 0 && contains(pvb, "zzz") == 0 && contains(pvb, "a$(id)") == 0,
      "fish: hidden verbs, unsafe verbs and unsafe flags are left out");

    test_group("1.3.7 completions without per-verb flags keep the 1.3.6 script");
    var pve = cmdit_new("ark");
    cmdit_bool(pve, 0, "no-color", "");
    cmdit_verb(pve, "install", "");
    var pveh = cmdit_verb(pve, "bench", "");
    cmdit_verb_hidden(pve, pveh);
    cmdit_verb_flags(pve, pveh, pvcbh);
    capture_completions(pve, "bash", pvb, 16384);
    assert(contains(pvb, "    local cur i w seen_verb=0 skip=0\n") == 1 && contains(pvb, " verb=") == 0
      && contains(pvb, "case") == 0, "bash: a handle attached only to a hidden verb changes nothing");
    assert(index_of(pvb, "    if [[ \"$cur\" == -* ]]; then\n") >= 0
      && index_of(pvb, "    if [[ \"$cur\" == -* ]]; then\n") < index_of(pvb, "    for (( i=1;"),
      "bash: the 1.3.6 order, flag branch first");
    capture_completions(pve, "zsh", pvb, 16384);
    assert(contains(pvb, "    local i seen=0 skip=0 w\n") == 1 && contains(pvb, "verb=") == 0
      && contains(pvb, "elif") == 0, "zsh: unchanged");
    capture_completions(pve, "fish", pvb, 16384);
    assert(contains(pvb, "__fish_seen_subcommand_from") == 0, "fish: unchanged");

    test_group("1.3.7 per-verb completion edge cases");
    var pvs = cmdit_new("sk");
    cmdit_stop_at_positional(pvs, 1);
    cmdit_bool(pvs, 0, "glob", "");
    var pvsv = cmdit_verb(pvs, "run", "");
    var pvsh = cmdit_new("sk run");
    cmdit_bool(pvsh, 0, "dry", "");
    cmdit_verb_flags(pvs, pvsv, pvsh);
    capture_completions(pvs, "bash", pvb, 16384);
    assert(contains(pvb, "            run) flags='--help --version --dry' ;;\n") == 1,
      "bash, stop-at-positional: the verb's list replaces the globals, its --help included");
    var pvo = cmdit_new("e");
    var pvov = cmdit_verb(pvo, "go", "");
    cmdit_verb_flags(pvo, pvov, cmdit_new("e go"));
    capture_completions(pvo, "bash", pvb, 16384);
    assert(contains(pvb, "        case \"$verb\" in\n        esac\n") == 1,
      "bash: a verb with only the auto flags adds nothing to the globals, so it gets no arm");
    capture_completions(pvo, "zsh", pvb, 16384);
    assert(contains(pvb, "            go) compadd -- --help --version ;;\n") == 1, "zsh: it still offers them");
    return 0;
}

# 1.4.0: the output-session sequences the buffering tests capture on fd 1.
fn ob_probe(mode, h): i64 {
    if (mode == 0) {                                 # the caller writes around a renderer
        syscall(1, 1, "pre|", 4);
        cmdit_version(h, "1");
        syscall(1, 1, "|post", 5);
    }
    if (mode == 1) {                                 # a session nested on the same stream
        var p1 = _cmdit_out_begin(1);
        _cmdit_oprint("A");
        var p2 = _cmdit_out_begin(1);
        _cmdit_oprint("X");
        _cmdit_out_end(p2);
        _cmdit_oprint("B");
        _cmdit_out_end(p1);
    }
    if (mode == 2) {                                 # a session nested on another stream
        var nul = syscall(2, "/dev/null", 1, 0);
        var se = syscall(32, 2);
        syscall(33, nul, 2);
        var q1 = _cmdit_out_begin(1);
        _cmdit_oprint("A");
        var q2 = _cmdit_out_begin(2);
        _cmdit_eprint("to stderr");
        _cmdit_out_end(q2);
        _cmdit_oprint("B");
        _cmdit_out_end(q1);
        syscall(33, se, 2);
        syscall(3, se);
        syscall(3, nul);
    }
    if (mode == 3) {                                 # a write to another stream mid-session
        var nul3 = syscall(2, "/dev/null", 1, 0);
        var se3 = syscall(32, 2);
        syscall(33, nul3, 2);
        var r1 = _cmdit_out_begin(1);
        _cmdit_oprint("A");
        _cmdit_eprint("E");
        _cmdit_oprint("B");
        _cmdit_out_end(r1);
        syscall(33, se3, 2);
        syscall(3, se3);
        syscall(3, nul3);
    }
    if (mode == 4) {                                 # pieces up to and past the buffer
        var big = alloc(6001);
        var bi = 0;
        while (bi < 6000) { store8(big + bi, 48 + bi % 10); bi = bi + 1; }
        store8(big + 6000, 0);
        var w1 = _cmdit_out_begin(1);
        _cmdit_oprint("<");
        _cmdit_write(1, big, 4000);
        if (_cmdit_ob_n > ob_peak) { ob_peak = _cmdit_ob_n; }
        _cmdit_write(1, big, 6000);
        if (_cmdit_ob_n > ob_peak) { ob_peak = _cmdit_ob_n; }
        _cmdit_write(1, big, 4096);
        if (_cmdit_ob_n > ob_peak) { ob_peak = _cmdit_ob_n; }
        _cmdit_oprint(">");
        _cmdit_out_end(w1);
    }
    return 0;
}

var ob_peak = 0;                                     # mode 4: the most the buffer held

# 1.4.0: capture fd 1 around ob_probe(mode, h).
fn capture_probe(mode, h, buf, cap): i64 {
    var pfd[8];
    if (syscall(22, &pfd) != 0) { return 0 - 1; }
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);
    var saved = syscall(32, 1);
    syscall(33, wfd, 1);
    ob_probe(mode, h);
    syscall(33, saved, 1);
    syscall(3, wfd);
    syscall(3, saved);
    var n = syscall(0, rfd, buf, cap - 1);
    syscall(3, rfd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

# 1 when no output session is open and nothing is left in the buffer.
fn ob_idle(): i64 {
    if (_cmdit_ob_depth != 0 || _cmdit_ob_n != 0) { return 0; }
    if (_cmdit_ob_fd != 0 - 1) { return 0; }
    return 1;
}

# 1.4.0 buffered output: one write per renderer, same bytes, same order
fn g110_1_4_0_buffered_output(): i64 {
    test_group("1.4.0 buffered output: one write per renderer, same bytes, same order");
    var obb = alloc(16384);
    var obh = cmdit_new("tool");
    assert(capture_probe(0, obh, obb, 16384) > 0, "capture");
    assert(cstreq(obb, "pre|tool 1\n|post") == 1, "a renderer's output lands before the caller's next write");
    capture_probe(1, obh, obb, 16384);
    assert(cstreq(obb, "AXB") == 1, "a nested session on the same stream keeps the order");
    capture_probe(2, obh, obb, 16384);
    assert(cstreq(obb, "AB") == 1, "a nested session on another stream writes there, and the outer resumes");
    capture_probe(3, obh, obb, 16384);
    assert(cstreq(obb, "AB") == 1, "a write to another stream during a session goes there, not into the buffer");
    var obpn = capture_probe(4, obh, obb, 16384);
    assert(obpn == 1 + 4000 + 6000 + 4096 + 1, "pieces of 4000, 6000 and 4096 bytes all arrive");
    assert(load8(obb) == 60 && load8(obb + 1) == 48 && load8(obb + 4001) == 48 && load8(obb + 10001) == 48
      && load8(obb + obpn - 1) == 62, "in order");
    assert(ob_peak <= 4096, "and the buffer never held more than its 4096 bytes");
    assert(ob_idle() == 1, "no session is left open");
    # Past the 4096-byte buffer: 50 flags with ~100-byte help each.
    var obl = cmdit_new("big");
    var obk = 0;
    while (obk < 50) {
        var obn = alloc(4);
        store8(obn, 102); store8(obn + 1, 48 + obk / 10); store8(obn + 2, 48 + obk % 10); store8(obn + 3, 0);
        var obt = alloc(101);
        var obj = 0;
        while (obj < 100) { store8(obt + obj, 97 + (obk + obj) % 26); obj = obj + 1; }
        store8(obt + 100, 0);
        cmdit_bool(obl, 0, obn, obt);
        obk = obk + 1;
    }
    var obln = capture_render(obl, 1, 1, obb, 16384);
    assert(obln > 4096, "the flag rows are longer than the buffer");
    var obrows = 0;
    var obi = 0;
    while (obi < obln) { if (load8(obb + obi) == 10) { obrows = obrows + 1; } obi = obi + 1; }
    assert(obrows == 52, "every row is there, once (50 + --help + --version)");
    assert(index_of(obb, "--f00\t") < index_of(obb, "--f25\t") && index_of(obb, "--f25\t") < index_of(obb, "--f49\t"),
      "in registration order across the flushes");
    assert(ob_idle() == 1, "and the session is closed");
    # One piece larger than the whole buffer goes straight out, after what was buffered.
    var obg = cmdit_new("g");
    var obgh = alloc(5001);
    var obm = 0;
    while (obm < 5000) { store8(obgh + obm, 121); obm = obm + 1; }
    store8(obgh + 5000, 0);
    cmdit_bool(obg, 0, "big", obgh);
    cmdit_bool(obg, 0, "after", "z");
    var obgn = capture_render(obg, 1, 1, obb, 16384);
    var obat = index_of(obb, "      --big\t");
    assert(obat > 0 && load8(obb + obat + 12) == 121 && load8(obb + obat + 12 + 4999) == 121,
      "the 5000-byte help is there whole");
    assert(cstreq(obb + obat + 12 + 5000, "\n      --after\tz\n") == 1, "and the row after it follows it");
    assert(obgn == obat + 12 + 5000 + 17, "nothing else, nothing twice");
    # Every renderer closes its session, whatever it printed.
    var obe = cmdit_new("e");
    cmdit_verb(obe, "add", "x");
    var obev = alloc(3 * 8);
    store64(obev, "e"); store64(obev + 8, "nope"); store64(obev + 16, 0);
    cmdit_dispatch_argv(obe, 2, obev);
    capture_print_error(obe, obb, 16384);
    assert(contains(obb, "unknown command: nope\n\nCommands:\n  add\tx\n") == 1,
      "an error line and its nested command list, in order");
    assert(ob_idle() == 1, "print_error closes its session");
    capture_completions(obe, "elvish", obb, 16384);
    assert(load8(obb) == 0, "an unknown shell prints nothing");
    assert(ob_idle() == 1, "completions close their session on the unknown-shell path too");
    capture_completions(obe, "fish", obb, 16384);
    assert(ob_idle() == 1, "and after a script");
    capture_help(obe, obb, 16384);
    capture_version(obe, "2", obb, 16384);
    capture_render(obe, 2, 1, obb, 16384);
    assert(ob_idle() == 1, "help, version and the verb list close theirs");
    return 0;
}

# 1.4.0 lazy verb table: rows survive the table moving as it doubles
fn g111_1_4_0_lazy_verb_table(): i64 {
    test_group("1.4.0 lazy verb table: rows survive the table moving as it doubles");
    var lv = cmdit_new("big");
    assert(load64(lv + _CMDIT_H_VERBS) == 0, "no table before the first verb");
    var lvh = cmdit_new("big v7");
    cmdit_bool(lvh, 0, "seven", "");
    var lvk = 0;
    while (lvk < 40) {
        var lvn = alloc(4);
        store8(lvn, 118); store8(lvn + 1, 48 + lvk / 10); store8(lvn + 2, 48 + lvk % 10); store8(lvn + 3, 0);
        assert(cmdit_verb(lv, lvn, lvn) == lvk, "verb ids are row indices");
        if (lvk == 0) { assert(load64(lv + _CMDIT_H_VERBS_CAP) == 16, "the first verb allocates 16 rows"); }
        if (lvk == 3) { cmdit_verb_hidden(lv, 3); }
        if (lvk == 5) { cmdit_verb_trailing_after(lv, 5, 1); }
        if (lvk == 7) { cmdit_verb_flags(lv, 7, lvh); }
        if (lvk == 16) { assert(load64(lv + _CMDIT_H_VERBS_CAP) == 32, "the 17th doubles it"); }
        lvk = lvk + 1;
    }
    assert(load64(lv + _CMDIT_H_VERBS_CAP) == 64, "40 verbs -> 64 rows");
    assert(cmdit_verb_alias(lv, 0, "first") == 0, "an alias added after the moves");
    assert(cstreq(cmdit_verb_name_at(lv, 0), "v00") == 1 && cstreq(cmdit_verb_name_at(lv, 39), "v39") == 1,
      "names from before and after the moves");
    assert(cstreq(cmdit_verb_name_at(lv, 15), "v15") == 1 && cstreq(cmdit_verb_name_at(lv, 31), "v31") == 1,
      "the last row before each move came along");
    assert(cstreq(cmdit_verb_help_at(lv, 40), "v00") == 1, "the alias row reads its verb's help");
    assert(cmdit_verb_is_hidden(lv, 3) == 1 && cmdit_verb_is_hidden(lv, 4) == 0, "the hidden mark survived");
    assert(cmdit_verb_trailing_at(lv, 5) == 1, "the trailing mark survived");
    assert(cmdit_verb_flags_at(lv, 7) == lvh, "the attached handle survived");
    var lva = alloc(4 * 8);
    store64(lva, "big"); store64(lva + 8, "first"); store64(lva + 16, "x"); store64(lva + 24, 0);
    assert(cmdit_dispatch_argv(lv, 3, lva) == CMDIT_OK && cmdit_verb_matched(lv) == 0, "the alias dispatches");
    var lvb = cmdit_new("big");
    var lvj = 0;
    while (lvj < 128) { cmdit_verb(lvb, "v", ""); lvj = lvj + 1; }
    assert(load64(lvb + _CMDIT_H_VERBS_CAP) == 128 && cmdit_verb(lvb, "w", "") == 0 - 1,
      "it stops at 128 rows, and the 129th is refused");
    return 0;
}

# 1.4.0 lazy entry table: flags and their modifiers survive the table moving
fn g112_1_4_0_lazy_entry_table(): i64 {
    test_group("1.4.0 lazy entry table: flags and their modifiers survive the table moving");
    var le = cmdit_new("big");
    assert(load64(le + _CMDIT_H_ENTRIES_CAP) == 16, "cmdit_new allocates 16 entries");
    var lec = cmdit_enum(le, 0, "color", "auto", "auto|always|never", "c");
    cmdit_enum_nocase(le, lec);
    var len_ = cmdit_int(le, 110, "num", 5, "n");
    cmdit_range(le, len_, 1, 9);
    cmdit_once(le, len_);
    var leo = cmdit_str(le, 111, "out", "a.txt", "o");
    cmdit_metavar(le, leo, "FILE");
    cmdit_long_alias(le, leo, "output");
    cmdit_reject_flag_value(le, leo);
    var leh = cmdit_repeat(le, 72, "header", "h");
    var ler = cmdit_bool(le, 0, "sure", "s");
    cmdit_required(le, ler);
    var lek = 0;
    while (lek < 35) {
        var lenm = alloc(4);
        store8(lenm, 102); store8(lenm + 1, 48 + lek / 10); store8(lenm + 2, 48 + lek % 10); store8(lenm + 3, 0);
        cmdit_bool(le, 0, lenm, "");
        lek = lek + 1;
    }
    assert(cmdit_flag_count(le) == 42 && load64(le + _CMDIT_H_ENTRIES_CAP) == 64, "42 flags -> 64 entries");
    assert(cstreq(cmdit_flag_choices_at(le, lec), "auto|always|never") == 1, "an enum's choices survived");
    assert(cstreq(cmdit_flag_metavar_at(le, leo), "FILE") == 1, "a metavar survived");
    assert(cstreq(cmdit_flag_long_alias_at(le, leo), "output") == 1, "a second long name survived");
    assert(cmdit_flag_is_required(le, ler) == 1 && cmdit_flag_is_repeat(le, leh) == 1, "required and repeat bits");
    assert(cmdit_get_int(le, len_) == 5 && cstreq(cmdit_get_str(le, leo), "a.txt") == 1, "defaults");
    var lea = alloc(12 * 8);
    store64(lea, "big"); store64(lea + 8, "--color=NEVER"); store64(lea + 16, "-n"); store64(lea + 24, "7");
    store64(lea + 32, "--output"); store64(lea + 40, "x"); store64(lea + 48, "-H"); store64(lea + 56, "a");
    store64(lea + 64, "-H"); store64(lea + 72, "b"); store64(lea + 80, "--f34"); store64(lea + 88, 0);
    assert(cmdit_parse_argv(le, 11, lea) == CMDIT_OK, "a parse over flags from both sides of the moves");
    assert(cmdit_get_enum(le, lec) == 2, "case-insensitive enum");
    assert(cmdit_get_int(le, len_) == 7 && cstreq(cmdit_get_str(le, leo), "x") == 1, "values");
    assert(cmdit_repeat_count(le, leh) == 2, "the repeat list");
    assert(cmdit_get_bool(le, cmdit_flag_find_long(le, "f34", 3)) == 1, "the last flag");
    assert(cmdit_finalize(le) == CMDIT_RESULT_ERR && cmdit_error(le) == CMDIT_ERR_REQUIRED_MISSING
      && cmdit_err_flag(le) == ler, "the required flag is still checked");
    store64(lea + 8, "--num=4"); store64(lea + 16, "--num=5"); store64(lea + 24, 0);
    var le2 = cmdit_new("t");
    var le2n = cmdit_int(le2, 0, "num", 0, "");
    cmdit_once(le2, le2n);
    assert(cmdit_parse_argv(le2, 3, lea) == CMDIT_RESULT_ERR && cmdit_err_flag(le2) == le2n, "a failed parse");
    var lej = 0;
    while (lej < 20) { cmdit_bool(le2, 0, "z", ""); lej = lej + 1; }
    assert(load64(le2 + _CMDIT_H_ENTRIES_CAP) == 32, "registrations after it moved the table");
    assert(cmdit_err_flag(le2) == le2n, "cmdit_err_flag still names the flag (err_entry moved with the table)");
    var leb = alloc(256);
    capture_print_error(le2, leb, 256);
    assert(cstreq(leb, "t: --num: may be given only once\n") == 1, "and the error line still names it");
    return 0;
}

# 1.4.0 long-name lookup: the first-byte prefilter and pointer walk change no answer
fn g113_1_4_0_long_name_lookup(): i64 {
    test_group("1.4.0 long-name lookup: the first-byte prefilter and pointer walk change no answer");
    var lk = cmdit_new("t");
    var lkv = cmdit_bool(lk, 0, "vision", "");
    var lkf = cmdit_bool(lk, 0, "vision-fd", "");
    var lka = cmdit_bool(lk, 0, "view", "");
    cmdit_long_alias(lk, lka, "v");
    var lke = cmdit_bool(lk, 0, "", "");
    assert(cmdit_flag_find_long(lk, "vision-fd", 9) == lkf, "names sharing a first byte: the longer one");
    assert(cmdit_flag_find_long(lk, "vision", 6) == lkv, "and the shorter one");
    assert(cmdit_flag_find_long(lk, "version", 7) == 1, "and the auto --version among them");
    assert(cmdit_flag_find_long(lk, "v", 1) == lka, "a one-byte second long name");
    assert(cmdit_flag_find_long(lk, "vi", 2) == 0 - 1, "a shared prefix alone matches nothing");
    assert(cmdit_flag_find_long(lk, "=x", 0) == lke, "an empty span finds the flag with an empty long name");
    var lkp = alloc(3 * 8);
    store64(lkp, "t"); store64(lkp + 8, "--=x"); store64(lkp + 16, 0);
    assert(cmdit_parse_argv(lk, 2, lkp) == CMDIT_RESULT_ERR && cmdit_err_flag(lk) == lke,
      "as the parser does for --=x (a bool given a value)");
    var lk2 = cmdit_new("t");
    cmdit_bool(lk2, 0, "x", "");
    assert(cmdit_flag_find_long(lk2, "=x", 0) == 0 - 1, "and without one, an empty span matches nothing");
    assert(cmdit_flag_find_short(lk2, 0) == 0 - 1, "a short lookup of byte 0 matches nothing either");
    return 0;
}

# 1.4.2 a command line past 2 MiB is whole; only an exact 2 MiB read is refused
fn g114_1_4_2_argv_past_2_mib(): i64 {
    test_group("1.4.2 a command line past 2 MiB is whole; only an exact 2 MiB read is refused");
    # A pre-6.7.12 args_init reads at most 2,097,152 bytes, and a 6.7.12+ one reads to EOF,
    # so any longer len came from a whole read. Exactly 2 MiB is the one ambiguous length:
    # the bundle compiles on pins whose args_init cuts there.
    assert(_cmdit_argv_whole(3, 2097152) == 0, "exactly 2 MiB may be a cut read -> not whole");
    assert(_cmdit_argv_whole(3, 2097153) == 1, "one byte past 2 MiB: no truncating read returns it -> whole");
    assert(_cmdit_argv_whole(32, 3000084) == 1, "a 3 MB read, as a 6.7.12+ args_init returns it -> whole");
    assert(_cmdit_argv_whole(3, 6291456) == 1, "6 MiB, the ARG_MAX ceiling -> whole");
    assert(_cmdit_argv_whole(0, 3000084) == 0, "a long read never stands in for a missing argv[0]");
    return 0;
}

# 1.5.0 completion scripts complete file names (sit L11)
fn g115_1_5_0_completion_files(): i64 {
    test_group("1.5.0 completion scripts complete file names (sit L11)");
    var cfb = alloc(16384);
    var cfh = cmdit_new("t");
    cmdit_verb(cfh, "x", "");
    capture_completions(cfh, "bash", cfb, 16384);
    assert(has_file_branch(cfb) == 1, "bash: one file name per line, and readline is told they are file names");
    assert(contains(cfb, "$(compgen -f") == 0, "bash: no unquoted substitution of file names is left");
    assert(index_of(cfb, "compopt") > index_of(cfb, "compgen -W \"$verbs\""),
      "bash: compopt only in the file branch, so a verb never gets a directory's /");
    var cfv = cmdit_new("t");
    var cfvv = cmdit_verb(cfv, "x", "");
    var cfvh = cmdit_new("t x");
    cmdit_bool(cfvh, 0, "dry", "");
    cmdit_verb_flags(cfv, cfvv, cfvh);
    capture_completions(cfv, "bash", cfb, 16384);
    assert(contains(cfb, "        case \"$verb\" in\n") == 1 && has_file_branch(cfb) == 1,
      "bash: the same file branch in the layout that remembers the verb");
    capture_completions(cfh, "fish", cfb, 16384);
    assert(contains(cfb, "complete -c t -f\ncomplete -c t -n 'not __fish_use_subcommand' -F\n") == 1,
      "fish: files come back once a verb is typed");
    capture_completions(cfv, "fish", cfb, 16384);
    assert(contains(cfb, "complete -c t -f\ncomplete -c t -n 'not __fish_use_subcommand' -F\n") == 1,
      "fish: with per-verb flags too");
    capture_completions(cfh, "zsh", cfb, 16384);
    assert(contains(cfb, "    else\n        _files\n    fi\n") == 1, "zsh: _files, unchanged");

    # Each line is one completion: the candidate count, then the candidates sorted, each
    # in []. `my` then `g` in a row also shows COMPREPLY is reset on every call.
    capture_completions(cfh, "bash", cfb, 16384);
    var drv = alloc(2048);
    store8(drv, 0);
    cat_cstr(drv, "D=$(mktemp -d) || exit 3\ncd \"$D\" || exit 3\n");
    cat_cstr(drv, ": > 'my file.txt'; : > 'g*'; : > gx; : > gy; : > ' lead'; : > 'b\\x'\n");
    cat_cstr(drv, "cfr() {\n    COMP_WORDS=(t \"$@\"); COMP_CWORD=$(( ${#COMP_WORDS[@]} - 1 ))\n");
    cat_cstr(drv, "    _t_complete\n    printf '%s:' \"${#COMPREPLY[@]}\"\n");
    cat_cstr(drv, "    printf '%s\\n' \"${COMPREPLY[@]}\" | LC_ALL=C sort |\n");
    cat_cstr(drv, "        while IFS= read -r c; do printf '[%s]' \"$c\"; done\n    printf '\\n'\n}\n");
    cat_cstr(drv, "printf 'BEGIN\\n'\ncfr x my\ncfr x g\ncfr x ' l'\ncfr x b\ncfr ''\n");
    cat_cstr(drv, "cd / && rm -rf \"$D\"\n");
    var rbo = alloc(4096);
    var rbn = run_bash(cfb, drv, rbo, 4096);
    if (rbn < 0) {
        println("  (skipped the bash run: no /bin/bash)");
    } else {
        assert(contains(rbo, "BEGIN\n1:[my file.txt]\n") == 1, "bash, run: a name with a space is one candidate");
        assert(contains(rbo, "\n3:[g*][gx][gy]\n") == 1, "bash, run: a name with a * is not globbed");
        assert(contains(rbo, "\n1:[ lead]\n") == 1, "bash, run: a leading space survives");
        assert(contains(rbo, "\n1:[b\\x]\n") == 1, "bash, run: a backslash survives");
        assert(contains(rbo, "\n1:[x]\n") == 1, "bash, run: the verb position still offers verbs, not files");
    }
    return 0;
}

