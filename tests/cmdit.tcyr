# cmdit test suite — drives the PURE parser core (cmdit_parse_argv) with
# synthetic argv arrays (no /proc), the same testability the survey found in
# takumi/yo/thoth. The entry includes its stdlib explicitly, like smoke (see the
# note there).
include "lib/vec.cyr"      # vec_get (transitively referenced by string/alloc)
include "lib/args.cyr"     # pulls syscalls + alloc (the synthetic argv arrays use alloc)
include "lib/string.cyr"   # strlen (cmdit help/error paths)
include "lib/fmt.cyr"      # resolves io.cyr's fmt_int refs
include "lib/io.cyr"       # getenv (cmdit_env / cmdit_finalize)
include "lib/assert.cyr"   # test_group / assert / assert_summary
include "src/cmdit.cyr"

# cstr equality (both NUL-terminated)
fn cstreq(a, b): i64 {
    var i = 0;
    while (load8(a + i) != 0 && load8(b + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(a + i) != load8(b + i)) { return 0; }
    return 1;
}

# --- 1.2.4: capture the completion emitters' real stdout -----------------------
# The generated script is the artefact that gets SOURCED, so the security test
# has to assert on the bytes actually emitted, not merely on the helper the
# emitter is supposed to call. Testing the predicate alone would still pass if
# someone dropped the sanitiser call from an emitter. pipe(2) + dup2(2) on fd 1;
# the scripts are ~1-2 KB against a 64 KB pipe buffer, so no deadlock.
fn capture_completions(h, shell, buf, cap): i64 {
    var pfd[8];                                  # int fds[2]
    if (syscall(22, &pfd) != 0) { return 0 - 1; }
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);
    var saved = syscall(32, 1);                  # dup(1)
    syscall(33, wfd, 1);                         # dup2(wfd, 1)
    cmdit_completions(h, shell);
    syscall(33, saved, 1);                       # restore fd 1
    syscall(3, wfd);
    syscall(3, saved);
    var n = syscall(0, rfd, buf, cap - 1);       # read
    syscall(3, rfd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

# 1.3.1: the same capture on fd 2, for cmdit_print_error's exact line.
fn capture_print_error(h, buf, cap): i64 {
    var pfd[8];                                  # int fds[2]
    if (syscall(22, &pfd) != 0) { return 0 - 1; }
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);
    var saved = syscall(32, 2);                  # dup(2)
    syscall(33, wfd, 2);                         # dup2(wfd, 2)
    cmdit_print_error(h);
    syscall(33, saved, 2);                       # restore fd 2
    syscall(3, wfd);
    syscall(3, saved);
    var n = syscall(0, rfd, buf, cap - 1);       # read
    syscall(3, rfd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

# 1.3.3: capture cmdit_help (fd 2) and cmdit_version (fd 1) output, as above.
fn capture_help(h, buf, cap): i64 {
    var pfd[8];
    if (syscall(22, &pfd) != 0) { return 0 - 1; }
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);
    var saved = syscall(32, 2);
    syscall(33, wfd, 2);
    cmdit_help(h);
    syscall(33, saved, 2);
    syscall(3, wfd);
    syscall(3, saved);
    var n = syscall(0, rfd, buf, cap - 1);
    syscall(3, rfd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

# 1.3.5: capture one renderer's output on `fd`. which: 0 help_fd, 1 help_flags_fd,
# 2 verbs_help_fd (each called with `fd`); 3 help, 4 help_flags, 5 verbs_help (the
# stderr wrappers; capture with fd 2).
fn capture_render(h, which, fd, buf, cap): i64 {
    var pfd[8];
    if (syscall(22, &pfd) != 0) { return 0 - 1; }
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);
    var saved = syscall(32, fd);
    syscall(33, wfd, fd);
    if (which == 0) { cmdit_help_fd(h, fd); }
    if (which == 1) { cmdit_help_flags_fd(h, fd); }
    if (which == 2) { cmdit_verbs_help_fd(h, fd); }
    if (which == 3) { cmdit_help(h); }
    if (which == 4) { cmdit_help_flags(h); }
    if (which == 5) { cmdit_verbs_help(h); }
    syscall(33, saved, fd);
    syscall(3, wfd);
    syscall(3, saved);
    var n = syscall(0, rfd, buf, cap - 1);
    syscall(3, rfd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

# Capture cmdit_version(h, v)'s stdout into buf.
fn capture_version(h, v, buf, cap): i64 {
    var pfd[8];
    if (syscall(22, &pfd) != 0) { return 0 - 1; }
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);
    var saved = syscall(32, 1);
    syscall(33, wfd, 1);
    cmdit_version(h, v);
    syscall(33, saved, 1);
    syscall(3, wfd);
    syscall(3, saved);
    var n = syscall(0, rfd, buf, cap - 1);
    syscall(3, rfd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

# --- 1.5.0: run a generated bash script for real -------------------------------
# The substring checks pin the emitted lines; this pins what bash does with them.
# Write all of cstr `s` to `fd`.
fn pipe_write_all(fd, s): i64 {
    var n = strlen(s);
    var off = 0;
    while (off < n) {
        var w = syscall(1, fd, s + off, n - off);                 # write
        if (w <= 0) { return 0 - 1; }
        off = off + w;
    }
    return off;
}

# `bash -s` reads `script` and then `driver` from a pipe on its stdin, and its stdout
# comes back in `out`. Only these fixed bytes reach bash: no argv and no command string
# is built from anything. Both are a few KB against a 64 KB pipe buffer, so writing them
# all before reading cannot block. Returns the bytes read, or -1 when /bin/bash is
# missing or a pipe or fork fails.
fn run_bash(script, driver, out, cap): i64 {
    if (syscall(21, "/bin/bash", 1) != 0) { return 0 - 1; }      # access(X_OK)
    var ip[8];                                                    # int fds[2]: bash's stdin
    var op[8];                                                    # int fds[2]: bash's stdout
    if (syscall(22, &ip) != 0) { return 0 - 1; }                  # pipe
    if (syscall(22, &op) != 0) { return 0 - 1; }
    var pid = syscall(57);                                        # fork
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        syscall(33, load32(&ip), 0);                              # dup2: stdin
        syscall(33, load32(&op + 4), 1);                          # dup2: stdout
        syscall(3, load32(&ip));
        syscall(3, load32(&ip + 4));
        syscall(3, load32(&op));
        syscall(3, load32(&op + 4));
        var av[24];
        store64(&av, "/bin/bash");
        store64(&av + 8, "-s");
        store64(&av + 16, 0);
        var ev[16];
        store64(&ev, "PATH=/usr/bin:/bin");
        store64(&ev + 8, 0);
        syscall(59, "/bin/bash", &av, &ev);                       # execve
        syscall(60, 127);                                         # exit: only if exec failed
    }
    syscall(3, load32(&ip));
    syscall(3, load32(&op + 4));
    var wfd = load32(&ip + 4);
    pipe_write_all(wfd, script);
    pipe_write_all(wfd, driver);
    syscall(3, wfd);
    var rfd = load32(&op);
    var n = 0;
    var r = 1;
    while (r > 0 && n < cap - 1) {
        r = syscall(0, rfd, out + n, cap - 1 - n);                # read to EOF
        if (r > 0) { n = n + r; }
    }
    syscall(3, rfd);
    var st[8];
    syscall(61, pid, &st, 0, 0);                                  # wait4
    store8(out + n, 0);
    return n;
}

# 1 when `hay` contains `needle` (both NUL-terminated).
fn contains(hay, needle): i64 {
    var i = 0;
    while (load8(hay + i) != 0) {
        var k = 0;
        while (load8(needle + k) != 0 && load8(hay + i + k) == load8(needle + k)) { k = k + 1; }
        if (load8(needle + k) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1.3.7: a fresh cstr holding `a` then `b`, so an expected script line longer
# than the lint's 120 columns can be written in two pieces and still matched whole.
fn cat2(a, b): i64 {
    var na = strlen(a);
    var nb = strlen(b);
    var r = alloc(na + nb + 1);
    var i = 0;
    while (i < na) { store8(r + i, load8(a + i)); i = i + 1; }
    i = 0;
    while (i < nb) { store8(r + na + i, load8(b + i)); i = i + 1; }
    store8(r + na + nb, 0);
    return r;
}

# 1.3.7: byte offset of the first `needle` in `hay`, or -1 — for asserting the
# ORDER of two lines in a generated script.
fn index_of(hay, needle): i64 {
    var i = 0;
    while (load8(hay + i) != 0) {
        var k = 0;
        while (load8(needle + k) != 0 && load8(hay + i + k) == load8(needle + k)) { k = k + 1; }
        if (load8(needle + k) == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# 1.5.0: append cstr `s` to the NUL-terminated string in `buf`.
fn cat_cstr(buf, s): i64 {
    var n = strlen(buf);
    var k = strlen(s);
    memcpy(buf + n, s, k);
    store8(buf + n + k, 0);
    return n + k;
}

# 1.5.0: 1 when `buf` holds the bash file branch, its three lines in a row and closing
# the function.
fn has_file_branch(buf): i64 {
    var a = "    compopt -o filenames 2>/dev/null\n    COMPREPLY=()\n";
    var b = "    while IFS= read -r w; do COMPREPLY+=( \"$w\" ); done < <(compgen -f -- \"$cur\")\n}\n";
    var ia = index_of(buf, a);
    if (ia < 0) { return 0; }
    if (index_of(buf, b) != ia + strlen(a)) { return 0; }
    return 1;
}

# parse: bool / int / str + positional (-c 5 --name bob file.txt)
fn g001_parse_bool_int_str(): i64 {
    test_group("parse: bool / int / str + positional (-c 5 --name bob file.txt)");
    var h = cmdit_new("t");
    var fL = cmdit_bool(h, 0, "loud", "");
    var fC = cmdit_int(h, 99, "count", 1, "");      # -c
    var fN = cmdit_str(h, 110, "name", 0, "");      # -n
    var av = alloc(7 * 8);
    store64(av + 0*8, "t"); store64(av + 1*8, "--loud"); store64(av + 2*8, "-c");
    store64(av + 3*8, "5"); store64(av + 4*8, "--name"); store64(av + 5*8, "bob");
    store64(av + 6*8, "file.txt");
    assert(cmdit_parse_argv(h, 7, av) == CMDIT_OK, "parse returns CMDIT_OK");
    assert(cmdit_get_bool(h, fL) == 1, "--loud set to 1");
    assert(cmdit_get_int(h, fC) == 5, "-c 5 parsed");
    assert(cstreq(cmdit_get_str(h, fN), "bob") == 1, "--name bob parsed");
    assert(cmdit_positional_count(h) == 1, "one positional");
    assert(cstreq(cmdit_positional(h, 0), "file.txt") == 1, "positional = file.txt");
    return 0;
}

# parse: --key=value attached form
fn g002_parse_key_value_attached(): i64 {
    test_group("parse: --key=value attached form");
    var h2 = cmdit_new("t");
    var c2 = cmdit_int(h2, 99, "count", 1, "");
    var av2 = alloc(2 * 8); store64(av2, "t"); store64(av2 + 8, "--count=7");
    assert(cmdit_parse_argv(h2, 2, av2) == CMDIT_OK, "parse OK");
    assert(cmdit_get_int(h2, c2) == 7, "--count=7 parsed");
    return 0;
}

# parse: -- terminator stops flag parsing
fn g003_parse_terminator_stops_flag(): i64 {
    test_group("parse: -- terminator stops flag parsing");
    var h3 = cmdit_new("t");
    var l3 = cmdit_bool(h3, 0, "loud", "");
    var av3 = alloc(3 * 8); store64(av3, "t"); store64(av3 + 8, "--"); store64(av3 + 16, "--loud");
    assert(cmdit_parse_argv(h3, 3, av3) == CMDIT_OK, "parse OK");
    assert(cmdit_get_bool(h3, l3) == 0, "--loud after -- NOT parsed as flag");
    assert(cmdit_positional_count(h3) == 1, "one positional");
    assert(cstreq(cmdit_positional(h3, 0), "--loud") == 1, "positional captured verbatim");
    return 0;
}

