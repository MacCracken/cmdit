    var fpx = cmdit_enum(hpx, 0, "color", "auto", "auto|always|never", "");
    var avpx = alloc(2 * 8); store64(avpx, "t"); store64(avpx + 8, "--color=neve");   # prefix of "never"
    assert(cmdit_parse_argv(hpx, 2, avpx) == CMDIT_RESULT_ERR, "prefix 'neve' rejected");
    assert(cmdit_error(hpx) == CMDIT_ERR_BAD_ENUM, "error = BAD_ENUM (not a partial match)");
    return 0;
}

# verb: an unknown flag BEFORE the verb is a hard error, not passed on
fn g064_verb_unknown_flag_before(): i64 {
